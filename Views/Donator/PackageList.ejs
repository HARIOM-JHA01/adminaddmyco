<%- include('../Layout/Header') %>
<link rel="stylesheet" href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css">
<%- include('../Layout/Sidebar') %>

<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3><a href="<%= baseUrl %>admin/dashboard" class="text-primary"><i class="fas fa-arrow-left me-2"></i></a>Donator Packages</h3>
        </div>
        <div class="col-12 col-md-6 order-md-2 order-first">
          <a href="<%= baseUrl %>admin/donator/package/create" class="btn btn-primary float-end">
            <i class="bi bi-plus-circle"></i> New Package
          </a>
        </div>
      </div>
    </div>

    <section class="section">
      <div class="card">
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped" id="packageTable">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>No. Of Employees</th>
                  <th>No. Of Operators</th>
                  <th>Price (USDT)</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (packages && packages.length > 0) { %>
                  <% packages.forEach(pkg => { %>
                  <tr>
                    <td><strong><%= pkg.name %></strong></td>
                    <td><span class="badge bg-info"><%= pkg.employeeCredits %></span></td>
                    <td><span class="badge bg-primary"><%= pkg.operatorCredits %></span></td>
                    <td>$<%= pkg.price %></td>
                    <td>
                      <% if (pkg.status === 1) { %>
                        <span class="badge bg-success">Active</span>
                      <% } else { %>
                        <span class="badge bg-danger">Inactive</span>
                      <% } %>
                    </td>
                    <td><%= moment(pkg.createdAt).format('DD-MM-YYYY') %></td>
                    <td>
                      <a href="<%= baseUrl %>admin/donator/package/edit/<%= pkg._id %>" class="btn btn-sm btn-warning">Edit</a>
                      <button class="btn btn-sm btn-danger delete-package" data-id="<%= pkg._id %>">Delete</button>
                    </td>
                  </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center text-muted">No packages found</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<footer>
  <div class="footer clearfix mb-0 text-muted">
    <div class="float-start">
      <p>2023 &copy; All rights are reserved</p>
    </div>
  </div>
</footer>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script type="application/json" id="server-data"><%- JSON.stringify({ baseUrl: baseUrl }) %></script>

<script>
  const serverData = JSON.parse(document.getElementById('server-data').textContent);
  const baseUrl = serverData.baseUrl;

  $(document).ready(function() {
    $('#packageTable').DataTable({
      "searching": true,
      "paging": true
    });
  });

  $(document).on('click', '.delete-package', function() {
    var id = $(this).data('id');
    Swal.fire({
      title: "Are you sure?",
      text: "You will not be able to recover this package!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#e74c3c",
      cancelButtonColor: "#6c757d",
      confirmButtonText: "Yes, delete it!"
    }).then((result) => {
      if (result.isConfirmed) {
        fetch(baseUrl + 'admin/donator/package/' + id, {
          method: "DELETE",
          headers: {
            'Content-Type': 'application/json'
          }
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.success) {
              Swal.fire(
                "Deleted!",
                "Package has been deleted.",
                "success"
              ).then(() => {
                location.reload();
              });
            } else {
              Swal.fire(
                "Error!",
                "Failed to delete package: " + (data.message || "Unknown error"),
                "error"
              );
            }
          })
          .catch((err) => {
            console.error("Error deleting package:", err);
            Swal.fire("Error!", "Error deleting package.", "error");
          });
      }
    });
  });
</script>
