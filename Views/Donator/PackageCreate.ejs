<%- include('../Layout/Header') %>
<%- include('../Layout/Sidebar') %>

<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3><a href="<%= baseUrl %>admin/donator/packages" class="text-primary"><i class="fas fa-arrow-left me-2"></i></a><%= isEdit ? 'Edit' : 'Create' %> Package</h3>
        </div>
      </div>
    </div>

    <section class="section">
      <div class="card">
        <div class="card-body">
          <form id="packageForm">
            <div class="form-group mb-3">
              <label for="name" class="form-label">Package Name *</label>
              <input type="text" class="form-control" id="name" name="name" value="<%= isEdit ? package.name : '' %>" required>
            </div>

            <div class="row">
              <div class="col-md-4">
                <div class="form-group mb-3">
                  <label for="employeeCredits" class="form-label">Employee Credits (No. of Employees) *</label>
                  <input type="number" class="form-control" id="employeeCredits" name="employeeCredits" value="<%= isEdit ? package.employeeCredits : 0 %>" required min="0">
                </div>
              </div>
              <div class="col-md-4">
                <div class="form-group mb-3">
                  <label for="operatorCredits" class="form-label">Operator Credits (No. of Operators) *</label>
                  <input type="number" class="form-control" id="operatorCredits" name="operatorCredits" value="<%= isEdit ? package.operatorCredits : 0 %>" required min="0">
                </div>
              </div>
              <div class="col-md-4">
                <div class="form-group mb-3">
                  <label for="price" class="form-label">Price (USDT) *</label>
                  <input type="number" class="form-control" id="price" name="price" value="<%= isEdit ? package.price : '' %>" required step="0.01" min="0">
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label for="status" class="form-label">Status</label>
                  <select class="form-control" id="status" name="status">
                    <option value="1" <%= !isEdit || package.status === 1 ? 'selected' : '' %>>Active</option>
                    <option value="0" <%= isEdit && package.status === 0 ? 'selected' : '' %>>Inactive</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="form-group">
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> <%= isEdit ? 'Update' : 'Create' %>
              </button>
              <a href="<%= baseUrl %>admin/donator/packages" class="btn btn-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </section>
  </div>
</div>

<footer>
  <div class="footer clearfix mb-0 text-muted">
    <div class="float-start">
      <p>2023 &copy; All rights are reserved</p>
    </div>
  </div>
</footer>
</div>

<script type="application/json" id="server-data"><%- JSON.stringify({ baseUrl: baseUrl, isEdit: !!isEdit, packageId: isEdit ? package._id : '' }) %></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  const serverData = JSON.parse(document.getElementById('server-data').textContent);
  const baseUrl = serverData.baseUrl;
  const donatorIsEdit = serverData.isEdit;
  const donatorPackageId = serverData.packageId;

  document.getElementById('packageForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const formData = {
      name: document.getElementById('name').value,
      employeeCredits: parseInt(document.getElementById('employeeCredits').value),
      operatorCredits: parseInt(document.getElementById('operatorCredits').value),
      price: parseFloat(document.getElementById('price').value),
      status: parseInt(document.getElementById('status').value)
    };

    try {
      const url = donatorIsEdit 
        ? baseUrl + 'admin/donator/package/edit/' + donatorPackageId
        : baseUrl + 'admin/donator/package/create';

      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(formData)
      });

      const result = await response.json();

      if (result.success) {
        // Show success modal
        Swal.fire(
          'Success!',
          result.message || (donatorIsEdit ? 'Package updated successfully!' : 'Package created successfully!'),
          'success'
        ).then(() => {
          window.location.href = baseUrl + 'admin/donator/packages';
        });
      } else {
        Swal.fire(
          'Error!',
          result.message || 'Something went wrong',
          'error'
        );
      }
    } catch (error) {
      console.error('Error:', error);
      Swal.fire(
        'Error!',
        error.message || 'An unexpected error occurred',
        'error'
      );
    }
  });
</script>
