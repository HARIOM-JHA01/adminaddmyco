<%- include('../Layout/Header') %>
<link
  rel="stylesheet"
  href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css"
/>
<%- include('../Layout/Sidebar') %>
<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3>
            <a href="<%= baseUrl %>admin/enterpriseuser" class="text-primary"
              ><i class="fas fa-arrow-left me-2"></i></a
            >Enterprise Details
          </h3>
        </div>
        <div class="col-12 col-md-6 order-md-2 order-first">
          <nav
            aria-label="breadcrumb"
            class="breadcrumb-header float-start float-lg-end"
          >
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <a href="<%= baseUrl %>admin/dashboard">Dashboard</a>
              </li>
              <li class="breadcrumb-item">
                <a href="<%= baseUrl %>admin/enterpriseuser">Enterprises</a>
              </li>
              <li class="breadcrumb-item active">Details</li>
            </ol>
          </nav>
        </div>
      </div>
    </div>

    <section class="section">
      <!-- Enterprise Info Card -->
      <div class="card">
        <div class="card-header">
          <h4 class="card-title">Enterprise Information</h4>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <table class="table table-borderless">
                <tr>
                  <th width="200">Member ID:</th>
                  <td>
                    <strong><%= enterprise.memberid %></strong>
                  </td>
                </tr>
                <tr>
                  <th>Username:</th>
                  <td>
                    <% if (enterprise.username) { %>
                    <a
                      href="https://t.me/<%= enterprise.username %>"
                      target="_blank"
                      ><%= enterprise.username %></a
                    >
                    <% } else { %>
                    <span>N/A</span>
                    <% } %>
                  </td>
                </tr>
                <tr>
                  <th>TG ID:</th>
                  <td>
                    <% if (enterprise.tgid) { %>
                    <a
                      href="https://t.me/<%= enterprise.tgid %>"
                      target="_blank"
                      ><%= enterprise.tgid %></a
                    >
                    <% } else { %>
                    <span>N/A</span>
                    <% } %>
                  </td>
                </tr>
                <tr>
                  <th>Country:</th>
                  <td>
                    <%= enterprise.country ? enterprise.country : 'N/A' %> <% if
                    (enterprise.countryCode) { %> (<%= enterprise.countryCode %>) <% }
                    %>
                  </td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <table class="table table-borderless">
                <tr>
                  <th>Enterprise On Date:</th>
                  <td>
                    <%= enterprise.enterpriseOnDate ? moment(enterprise.enterpriseOnDate).format('DD-MM-YYYY HH:mm') : 'N/A' %>
                  </td>
                </tr>
                <tr>
                  <th>Total Employee Credits:</th>
                  <td>
                    <span class="badge bg-info"><%= stats.totalEmployeeCredits || 0 %></span>
                  </td>
                </tr>
                <tr>
                  <th>Total Operator Credits:</th>
                  <td>
                    <span class="badge bg-success"><%= stats.totalOperatorCredits || 0 %></span>
                  </td>
                </tr>
                <tr>
                  <th>Membership Type:</th>
                  <td>
                    <span class="badge bg-info"
                      >Enterprise</span
                    >
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Statistics Cards -->
      <div class="row">
        <div class="col-md-3">
          <div class="card">
            <div class="card-body">
              <h6 class="text-muted">Total Operators</h6>
              <h3><%= stats.totalOperators %></h3>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card">
            <div class="card-body">
              <h6 class="text-muted">Total Employees</h6>
              <h3><%= stats.totalEmployees %></h3>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card">
            <div class="card-body">
              <h6 class="text-muted">Total Purchases</h6>
              <h3><%= stats.totalPurchases %></h3>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card">
            <div class="card-body">
              <h6 class="text-muted">Approved Purchases</h6>
              <h3><%= stats.approvedPurchases %></h3>
            </div>
          </div>
        </div>
      </div>

      <!-- Operators Table -->
      <div class="card">
        <div class="card-header">
          <h4 class="card-title">Operators</h4>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped mb-0" id="operators_table">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Username</th>
                  <th>Credits</th>
                  <th>Active</th>
                  <th>Created Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (operators.length > 0) { %>
                  <% var i=1; operators.forEach(function(v) { %>
                  <tr id="operator-row-<%= v._id %>">
                    <td><%= i %></td>
                    <td><%= v.name %></td>
                    <td>
                      <span class="badge bg-info"><%= v.credits %></span>
                    </td>
                    <td>
                      <% if (v.isActive) { %>
                      <span class="badge bg-success">Yes</span>
                      <% } else { %>
                      <span class="badge bg-danger">No</span>
                      <% } %>
                    </td>
                    <td><%= moment(v.createdAt).format('DD-MM-YYYY') %></td>
                    <td>
                      <button class="btn btn-sm btn-info" onclick="viewOperator('<%= v._id %>')">View</button>
                      <button class="btn btn-sm btn-danger" onclick="deleteOperator('<%= v._id %>')">Delete</button>
                    </td>
                  </tr>
                  <% i++ %> 
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center text-muted">No operators found</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Employees Table -->
      <div class="card">
        <div class="card-header">
          <h4 class="card-title">Employees</h4>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped mb-0" id="employees_table">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Username</th>
                  <th>Member ID</th>
                  <th>Telegram ID</th>
                  <th>Country</th>
                  <th>Created Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (employees.length > 0) { %>
                  <% var i=1; employees.forEach(function(v) { %>
                  <tr id="employee-row-<%= v._id %>">
                    <td><%= i %></td>
                    <td><%= v.username %></td>
                    <td><%= v.memberid %></td>
                    <td>
                      <% if (v.tgid) { %>
                      <a href="https://t.me/<%= v.tgid %>" target="_blank"><%= v.tgid %></a>
                      <% } else { %>
                      N/A
                      <% } %>
                    </td>
                    <td><%= v.country %></td>
                    <td><%= moment(v.createdAt).format('DD-MM-YYYY') %></td>
                    <td>
                      <button class="btn btn-sm btn-info" onclick="viewEmployee('<%= v._id %>')">View</button>
                      <button class="btn btn-sm btn-danger" onclick="deleteEmployee('<%= v._id %>')">Delete</button>
                    </td>
                  </tr>
                  <% i++ %> 
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center text-muted">No employees found</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Purchases Table -->
      <div class="card">
        <div class="card-header">
          <h4 class="card-title">Package Purchases</h4>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped mb-0" id="purchases_table">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Operator</th>
                  <th>Package</th>
                  <th>Amount</th>
                  <th>Payment Method</th>
                  <th>Status</th>
                  <th>Purchase Date</th>
                </tr>
              </thead>
              <tbody>
                <% if (purchases.length > 0) { %>
                  <% var i=1; purchases.forEach(function(v) { %>
                  <tr>
                    <td><%= i %></td>
                    <td>
                      <% if (v.operator) { %>
                        <%= v.operator.name %>
                      <% } else { %>
                        N/A
                      <% } %>
                    </td>
                    <td>
                      <% if (v.package) { %>
                        <%= v.package.name %>
                      <% } else { %>
                        N/A
                      <% } %>
                    </td>
                    <td><%= v.amount %> <%= v.currency %></td>
                    <td><%= v.paymentMethod %></td>
                    <td>
                      <% if (v.status == 0) { %>
                      <span class="badge bg-warning">Pending</span>
                      <% } else if (v.status == 1) { %>
                      <span class="badge bg-success">Approved</span>
                      <% } else if (v.status == 2) { %>
                      <span class="badge bg-danger">Rejected</span>
                      <% } else { %>
                      <span class="badge bg-secondary">Cancelled</span>
                      <% } %>
                    </td>
                    <td><%= moment(v.createdAt).format('DD-MM-YYYY HH:mm') %></td>
                  </tr>
                  <% i++ %> 
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center text-muted">No purchases found</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>

<script>
  var baseUrl = '<%= baseUrl %>';
  $(document).ready(function () {
    $("#operators_table").DataTable({
      order: [[4, "desc"]],
    });
    $("#employees_table").DataTable({
      order: [[5, "desc"]],
    });
    $("#purchases_table").DataTable({
      order: [[6, "desc"]],
    });
  });

  // ---------- Operator (admin) ----------
  function viewOperator(id) {
    $.get(baseUrl + 'admin/enterprise/operator/detail/' + id)
      .done(function (res) {
        if (!res.success) return $.toast({ heading: 'Error', text: res.message || 'Unable to load', position: 'top-right', icon: 'error' });
        const op = res.data;
        $('#op_username').text(op.username || 'N/A');
        $('#op_name').text(op.name || 'N/A');
        $('#op_credits').text(op.credits || 0);
        $('#op_active').html(op.isActive ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-danger">No</span>');
        $('#op_created').text(op.createdAt ? moment(op.createdAt).format('DD-MM-YYYY HH:mm') : 'N/A');
        $('#op_employee_count').text(op.employeeCount || 0);
        $('#modal-delete-operator').off('click').on('click', function () { deleteOperator(op._id); });
        $('#operatorModal').modal('show');
      })
      .fail(function (err) {
        $.toast({ heading: 'Error', text: err.responseJSON?.message || 'Server error', position: 'top-right', icon: 'error' });
      });
  }

  function deleteOperator(id) {
    swal({ title: 'Confirm', text: 'Delete operator? This cannot be undone.', icon: 'warning', buttons: true }).then(function (confirm) {
      if (!confirm) return;
      $.post(baseUrl + 'admin/enterprise/operator/delete/' + id)
        .done(function (res) {
          if (res.success) {
            $.toast({ heading: 'Success', text: res.message, position: 'top-right', icon: 'success' });
            $('#operator-row-' + id).remove();
            $('#operatorModal').modal('hide');
          } else {
            $.toast({ heading: 'Error', text: res.message || 'Unable to delete operator', position: 'top-right', icon: 'error' });
          }
        })
        .fail(function (err) {
          $.toast({ heading: 'Error', text: err.responseJSON?.message || 'Server error', position: 'top-right', icon: 'error' });
        });
    });
  }

  // ---------- Employee (admin) ----------
  function viewEmployee(id) {
    $.get(baseUrl + 'admin/enterprise/employee/detail/' + id)
      .done(function (res) {
        if (!res.success) return $.toast({ heading: 'Error', text: res.message || 'Unable to load', position: 'top-right', icon: 'error' });
        const u = res.data;
        $('#emp_username').text(u.username || 'N/A');
        $('#emp_memberid').text(u.memberid || 'N/A');
        $('#emp_tgid').text(u.tgid || 'N/A');
        $('#emp_country').text(u.country || 'N/A');
        $('#emp_created').text(u.createdAt ? moment(u.createdAt).format('DD-MM-YYYY HH:mm') : 'N/A');
        $('#modal-delete-employee').off('click').on('click', function () { deleteEmployee(u._id); });
        $('#employeeModal').modal('show');
      })
      .fail(function (err) {
        $.toast({ heading: 'Error', text: err.responseJSON?.message || 'Server error', position: 'top-right', icon: 'error' });
      });
  }

  function deleteEmployee(id) {
    swal({ title: 'Confirm', text: 'Delete employee? This cannot be undone.', icon: 'warning', buttons: true }).then(function (confirm) {
      if (!confirm) return;
      $.post(baseUrl + 'admin/enterprise/employee/delete/' + id)
        .done(function (res) {
          if (res.success) {
            $.toast({ heading: 'Success', text: res.message, position: 'top-right', icon: 'success' });
            $('#employee-row-' + id).remove();
            $('#employeeModal').modal('hide');
          } else {
            $.toast({ heading: 'Error', text: res.message || 'Unable to delete employee', position: 'top-right', icon: 'error' });
          }
        })
        .fail(function (err) {
          $.toast({ heading: 'Error', text: err.responseJSON?.message || 'Server error', position: 'top-right', icon: 'error' });
        });
    });
  }
</script>

<!-- Operator detail modal -->
<div class="modal fade" id="operatorModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Operator Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <table class="table table-borderless">
          <tr><th>Username:</th><td id="op_username"></td></tr>
          <tr><th>Name:</th><td id="op_name"></td></tr>
          <tr><th>Credits:</th><td id="op_credits"></td></tr>
          <tr><th>Active:</th><td id="op_active"></td></tr>
          <tr><th>Created At:</th><td id="op_created"></td></tr>
          <tr><th>Employees:</th><td id="op_employee_count"></td></tr>
        </table>
      </div>
      <div class="modal-footer">
        <button class="btn btn-danger" id="modal-delete-operator">Delete</button>
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Employee detail modal -->
<div class="modal fade" id="employeeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Employee Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <table class="table table-borderless">
          <tr><th>Username:</th><td id="emp_username"></td></tr>
          <tr><th>Member ID:</th><td id="emp_memberid"></td></tr>
          <tr><th>Telegram ID:</th><td id="emp_tgid"></td></tr>
          <tr><th>Country:</th><td id="emp_country"></td></tr>
          <tr><th>Created At:</th><td id="emp_created"></td></tr>
        </table>
      </div>
      <div class="modal-footer">
        <button class="btn btn-danger" id="modal-delete-employee">Delete</button>
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<%- include('../Layout/Footer') %>
