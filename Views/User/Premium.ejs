<%- include('../Layout/Header') %>
<link rel="stylesheet" href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css">
import session from "express-session"
<%- include('../Layout/Sidebar') %>
<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3><a href="<%= baseUrl %>admin/dashboard" class="text-primary"><i class="fas fa-arrow-left me-2"></i></a>Premium Users</h3>
        </div>
        <div class="col-12 col-md-6 order-md-2 order-first">
          <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="<%= baseUrl %>admin/dashboard">Dashboard</a>
              </li>

            </ol>
          </nav>
        </div>
      </div>
    </div>
    <section class="section">
      <div class="card-body">
        <div class="category-filter">
          <label>
            Country:
            <select id="categoryFilter" class="form-control">
              <option value="">Show All</option>
              <% var i=1; country.forEach(function(v) { %>
              <option value="<% v._id.country%>"><%= v._id.country %></option>
              <% }) %>
            </select>
          </label>
        </div>
        <div class="table-responsive">
          <table class="table table-striped mb-0" id="filterTable">
            <thead>
              <tr>
                <th>No.</th>
                <th>Member Id</th>
                <th>UserName</th>
                <th>TG-id</th>
                <th>Email</th>
                <th>Country</th>
                <th>Membership Tenure</th>
                <th>Join-Date</th>
                <th>Start-Date</th>
                <th>End-Date</th>
                <th>Paid</th>
                <th></th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% var i=1; premium.forEach(function(v) { %>
              <% if( v.usertype == 1) { %>
              <tr data-id="<%= v._id%>">
                <td><span class="name-field">
                    <%= i %>
                  </span></td>
                <td><span class="name-field">
                    <%= v.memberid%>
                  </span></td>
                <td><span class="name-field">
                    <%= v.username%>
                  </span></td>
                <td><span class="name-field">
                    <a href="https://t.me/<%= v.tgid%>"> https://t.me/<%= v.tgid%></a>
                  </span></td>
                <td><span class="name-field">
                    <%= v.email%>
                  </span></td>
                <td><span class="name-field">
                    <%= v.country%>
                  </span></td>
                <td><span class="name-field">
                    <% 
                                                    let sumdata = 0;
                                                    if(v.userDoc != '') {
                                                    v.userDoc.forEach(function (err, devices) {
                                                        if(err.paymentstatus == 1)
                                                            sumdata = sumdata + parseInt(err.membershiperiod);
                                                    });
                                                  }
                                                    %>
                    <%= sumdata %> Years
                  </span></td>
                <td><span class="name-field">
                    <%=moment(v.date).format('DD-MM-YYYY') %>
                  </span></td>
                <td><span class="name-field">
                    <%= moment(v.startdate).format('DD-MM-YYYY')%>
                  </span></td>
                <td><span class="name-field">
                    <%= moment(v.enddate).format('DD-MM-YYYY')%>
                  </span></td>
                <td><span class="name-field">
                    <% if(v.userDoc != ''){ if(v.userDoc[0].paymenttype == 1){ %> toncoin
                    <% } else { %>
                    By&nbspAdmin
                    <% }} %>
                  </span></td>
                <td>
                  <% if(v.isReferral != 1){ %> 
                    <button type="button" id="refresh" class="btn  btn-refer">
                      <img src="../../assets/images/referral icon.png" class="img-fluid approve_btn" data-id = "<%= v.tgid%>" alt="referral">
                    </button>
                    <% } %>
                 
                </td>
                <td>
                  <div class="dropdown d-inline-block">
                    <button class="btn icon icon-left btn-primary btn-sm  " type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
                      <i class="bi bi-arrow-up-square"></i>
                    </button>
                    <ul class="dropdown-menu  dropdown-menu-end" aria-labelledby="dropdownMenuButton1">
                      <li><a class="dropdown-item delete-data1 " id="refresh" data-id="<%= v._id %>" href="#">Switched Donated</a>
                      </li>
                    </ul>
                  </div>
                  <button type="button" data-id="<%= v._id %>" id="refresh" class="btn icon icon-left btn-danger btn-sm delete-data"><i class="bi bi-trash"></i> </button>
                </td>
              </tr>
              <% i++ %>
              <% }%>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
  </div>
</div>

</section>
<footer>
  <div class="footer clearfix mb-0 text-muted">
    <div class="float-start">
      <p>2023 &copy; All rights are reserved</p>
    </div>

  </div>
</footer>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>


<script>
  $("document").ready(function() {
    $("#filterTable").dataTable({
      "searching": true
    });
    var table = $('#filterTable').DataTable();
    $("#filterTable_filter.dataTables_filter").prepend($(".category-filter"));

    var categoryIndex = 5;
    $.fn.dataTable.ext.search.push(
      function(settings, data, dataIndex) {
        var selectedItem = $('#categoryFilter').val()
        var category = data[categoryIndex];
        console.log(selectedItem);
        if (selectedItem === "" || category.includes(selectedItem)) {
          return true;
        }
        return false;
      }
    );
    $("#categoryFilter").change(function(e) {
      table.draw();
    });
    table.draw();
  });
</script>


<script>
  $(document).ready(function() {
    var table = $('#table1').DataTable({
      "bSort": false
    });
  });
</script>
<script>
  $(document).on('click', '.delete-data1', function() {
    var id = $(this).data("id");
    var baseUrl = '<%= baseUrl %>'
    swal({
        title: "Are you sure?",
        text: "You Want To Upgrade Your User Into Donated User?",
        icon: "warning",
        buttons: true,
        dangerMode: true,
      })
      .then((willDelete) => {
        if (willDelete) {
          $.ajax({
            type: "GET",
            url: `${baseUrl}admin/updatepremiumuser?id=${id}`,
            dataType: "json",
            statusCode: {
              200: function(xhr) {
                dataResult = xhr;
                $(`tr[data-id="${id}"]`).remove();
                console.log(dataResult.message)

                Toastify({
                  text: "Switched successfully...",
                  duration: 3000,
                  newWindow: true,
                  close: true,
                  gravity: "top", // `top` or `bottom`
                  position: "right", // `left`, `center` or `right`
                  stopOnFocus: true, // Prevents dismissing of toast on hover
                  style: {
                    background: "#0b6a3c",
                  },
                }).showToast();
              }
            },
          });
        }
      });
  });


  $(document).on('click', '.delete-data', function() {
    var id = $(this).data("id");
    var baseUrl = '<%= baseUrl %>'
    swal({
        title: "Are you sure?",
        text: "This user is premium user,are you sure you want to delete it?",
        icon: "warning",
        buttons: true,
        dangerMode: true,
      })
      .then((willDelete) => {
        if (willDelete) {
          $.ajax({
            type: "GET",
            url: `${baseUrl}admin/deletepremiumuser?id=${id}`,
            dataType: "json",
            statusCode: {
              200: function(xhr) {
                dataResult = xhr;
                $(`tr[data-id="${id}"]`).remove();
                console.log(dataResult.message)

                Toastify({
                  text: "Deleted successfully...",
                  duration: 3000,
                  newWindow: true,
                  close: true,
                  gravity: "top", // `top` or `bottom`
                  position: "right", // `left`, `center` or `right`
                  stopOnFocus: true, // Prevents dismissing of toast on hover
                  style: {
                    background: "#ff2c2c",
                  },
                }).showToast();
              }
            },
          });
        }
      });
  });

  let isTost = '<%= session.isTost %>'
  let msg = '<%= session.tostMsg %>'
  let tostBackground = '<%= session.tostBackground %>'
  if (isTost == "true") {
    Toastify({
      text: msg,
      duration: 3000,
      newWindow: true,
      close: true,
      gravity: "top", // `top` or `bottom`
      position: "right", // `left`, `center` or `right`
      stopOnFocus: true, // Prevents dismissing of toast on hover
      style: {
        background: tostBackground,
      },
    }).showToast();
    '<%= session.isTost = "false"%>'
  }
</script>

<script>
  $(document).on('click', '.approve_btn', function() {
    var id = $(this).data("id");
    var baseUrl = '<%= baseUrl %>'
    swal({
        title: "Are you sure?",
        text: "You Want to Referral this user?",
        icon: "warning",
        buttons: true,
        dangerMode: true,
      })
      .then((willDelete) => {
        if (willDelete) {
          $.ajax({
            type: "GET",
            url: `${baseUrl}admin/approvereferral?id=${id}`,
            dataType: "json",
            statusCode: {
              200: function(xhr) {
               location.reload(true);
              }
            }
          });
        }
      });
  });
</script>


<%- include('../Layout/Footer') %>