                <th>Partner Code</th>
                <th>Country</th>
                <th>Join-Date</th>
                <th>End-Date</th>
                <th>Paid</th>
                <th></th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% var i=1; premium.forEach(function(v) { %>
              <% if( v.usertype == 1) { %>
                <% console.log('3333', v) %>
              <tr data-id="<%= v._id%>">
                <td><span class="name-field">
                    <%= i %>
                  </span></td>
                <td><span class="name-field">
                    <%= v.memberid%>
                  </span></td>
                <td><span class="name-field">
                    <%= v.freeUsername || '-'%>
                  </span></td>
                <td><span class="name-field">
                    <%= v.username%>
                  </span></td>
                <td><span class="name-field">
                    <a href="https://t.me/<%= v.tgid%>"> https://t.me/<%= v.tgid%></a>
                  </span></td>
                <td><span class="name-field">
                  <%= v.paymentBy == 4 && v.partnerCode ? v.partnerCode : 'N/A' %>
                </span></td>
                <td><span class="name-field">
                    <%= v.country%>
                  </span></td>
                <!-- <td><span class="name-field">
                    <% 
                    let sumdata = 0;
                    if(v.userDoc != '') {
                    v.userDoc.forEach(function (err, devices) {
                        if(err.paymentstatus == 1)
                            sumdata = sumdata + parseInt(err.membershiperiod);
                    });
                  }                              
                   %>
                    <%= sumdata %> Years
                  </span></td> -->
                <td><span class="name-field">
                    <%=moment(v.date).format('DD-MM-YYYY') %>
                  </span></td>
                <!-- <td><span class="name-field">
                    <%= moment(v.startdate).format('DD-MM-YYYY')%>
                  </span></td> -->
                <td><span class="name-field">
                    <%= moment(v.enddate).format('DD-MM-YYYY')%>
                  </span></td>
                <td><span class="name-field">
                  <% if(v.paymentBy == 1){ %>
                    By USDT
              <% } else if(v.paymentBy == 2) { %>
                      By TgCoin
                      <% } else if(v.paymentBy == 3) { %>
                      By Admin
              <% } else if(v.paymentBy == 4) { %>
                      By Partner Renewal
              <% } else { %>
                    By Reward
                 <% } %>
                  </span></td>
                <!-- <td>
                  <% if(v.isReferral != 1){ %> 
                    <button type="button" id="refresh" class="btn  btn-refer">
                      <img src="../../assets/images/ref icon.png" class="img-fluid approve_btn" data-id = "<%= v.tgid%>" alt="referral">
                    </button>
                    <% } %>
                 
                </td> -->
                <td style="vertical-align: middle; text-align: center;">
                  <div style="display:flex;flex-direction:row;align-items:center;justify-content:center;gap:8px;">
                    <a class="delete-data1" data-id="<%= v._id %>" href="#">
                      <button type="button" style="border-radius:50%; background-color:green; color:white; border:none; width:35px; height:35px; display:flex; align-items:center; justify-content:center; cursor:pointer; font-weight:bold; padding:0;">E</button>
                    </a>
                    <button type="button" data-id="<%= v._id %>" class="btn btn-danger btn-sm delete-data" style="width:35px;height:35px;padding:0;display:flex;align-items:center;justify-content:center;"><i class="bi bi-trash"></i></button>
                  </div>
                </td>
              </tr>
              <% i++ %>
              <% }%>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
  </div>
</div>

</section>
<footer>
  <div class="footer clearfix mb-0 text-muted">
    <div class="float-start">
      <p>2023 &copy; All rights are reserved</p>
    </div>

  </div>
</footer>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>


<script>
$("document").ready(function () {
      $("#filterTable").dataTable({
        "searching": true
      });
      var table = $('#filterTable').DataTable();

      // ensure DataTables wrapper exists and find/create filter area
      var $wrapper = $('#filterTable').closest('.dataTables_wrapper');
      if ($wrapper.length === 0) {
        $wrapper = $('#filterTable').wrap('<div class="dataTables_wrapper"></div>').parent();
      }
      var $filterArea = $wrapper.find('#filterTable_filter.dataTables_filter');
      if ($filterArea.length === 0) {
        $filterArea = $('<div id="filterTable_filter" class="dataTables_filter"></div>');
        $wrapper.prepend($filterArea);
      }

      // Move country filter into the filter area (keeps alignment same as Free Users)
      $filterArea.css({ 'display': 'flex', 'align-items': 'center', 'gap': '12px' }).prepend($('.category-filter'));

      // Locate any DataTables search input and force it visible; otherwise add fallback
      var $dtSearchInput = $filterArea.find("input[type='search']");
      if ($dtSearchInput.length === 0) {
        $dtSearchInput = $wrapper.find("input[type='search']").first();
      }

      if ($dtSearchInput.length === 0) {
        var $customSearch = $("<label style='margin:0;'>Search: <input type='search' id='tableSearch' class='form-control' placeholder='Search anything...' style='display:inline-block;width:auto;min-width:220px;' /></label>");
        $filterArea.append($customSearch);
      } else {
        $dtSearchInput.attr('placeholder', 'Search anything...').css({ 'min-width': '220px', 'display': 'inline-block', 'visibility': 'visible', 'opacity': 1 });
        $dtSearchInput.closest('.dataTables_filter').css({ 'display': 'flex', 'align-items': 'center', 'gap': '12px' });
      }

      // Always bind #tableSearch (if present in DOM) to DataTables search so the input filters correctly
      if ($('#tableSearch').length) {
        $('#tableSearch').off('keyup.searchInput').on('keyup.searchInput search.searchInput input.searchInput', function() {
          table.search(this.value).draw();
        });
      }

      table.draw();
    });
</script>


<script>
  $(document).ready(function() {
    $('#categoryFilter').change(function() {
      var selectedCountry = $(this).val();
      var url = window.location.pathname;
      if (selectedCountry) {
        url += '?country=' + encodeURIComponent(selectedCountry);
      } else {
        url = window.location.pathname;
      }
      window.location.href = url;
    });
  });
</script>
<script>
  $(document).on('click', '.delete-data1', function() {
    var id = $(this).data("id");
    var baseUrl = '<%= baseUrl %>'
    swal({
        title: "Are you sure?",
        text: "You Want To Upgrade Your User Into Donated User?",
        icon: "warning",
        buttons: true,
        dangerMode: true,
      })
      .then((willDelete) => {
        if (willDelete) {
          $.ajax({
            type: "GET",
            url: `${baseUrl}admin/updatepremiumuser?id=${id}`,
            dataType: "json",
            statusCode: {
              200: function(xhr) {
                dataResult = xhr;
                $(`tr[data-id="${id}"]`).remove();
                console.log(dataResult.message)

                Toastify({
                  text: "Switched successfully...",
                  duration: 3000,
                  newWindow: true,
                  close: true,
                  gravity: "top", // `top` or `bottom`
                  position: "right", // `left`, `center` or `right`
                  stopOnFocus: true, // Prevents dismissing of toast on hover
                  style: {
                    background: "#0b6a3c",
                  },
                }).showToast();
              }
            },
          });
        }
      });
  });


  $(document).on('click', '.delete-data', function() {
    var id = $(this).data("id");
    var baseUrl = '<%= baseUrl %>'
    swal({
        title: "Are you sure?",
        text: "This user is premium user,are you sure you want to delete it?",
        icon: "warning",
        buttons: true,
        dangerMode: true,
      })
      .then((willDelete) => {
        if (willDelete) {
          $.ajax({
            type: "GET",
            url: `${baseUrl}admin/deletepremiumuser?id=${id}`,
            dataType: "json",
            statusCode: {
              200: function(xhr) {
                dataResult = xhr;
                $(`tr[data-id="${id}"]`).remove();
                console.log(dataResult.message)

                Toastify({
                  text: "Deleted successfully...",
                  duration: 3000,
                  newWindow: true,
                  close: true,
                  gravity: "top", // `top` or `bottom`
                  position: "right", // `left`, `center` or `right`
                  stopOnFocus: true, // Prevents dismissing of toast on hover
                  style: {
                    background: "#ff2c2c",
                  },
                }).showToast();
              }
            },
          });
        }
      });
  });

  let isTost = '<%= session.isTost %>'
  let msg = '<%= session.tostMsg %>'
  let tostBackground = '<%= session.tostBackground %>'
  if (isTost == "true") {
    Toastify({
      text: msg,
      duration: 3000,
      newWindow: true,
      close: true,
      gravity: "top", // `top` or `bottom`
      position: "right", // `left`, `center` or `right`
      stopOnFocus: true, // Prevents dismissing of toast on hover
      style: {
        background: tostBackground,
      },
    }).showToast();
    '<%= session.isTost = "false"%>'
  }
</script>

<script>
  $(document).on('click', '.approve_btn', function() {
    var id = $(this).data("id");
    var baseUrl = '<%= baseUrl %>'
    swal({
        title: "Are you sure?",
        text: "You Want to Referral this user?",
        icon: "warning",
