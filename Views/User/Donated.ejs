<%- include('../Layout/Header') %>
    <link rel="stylesheet" href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css">
    <%- include('../Layout/Sidebar') %>
        <style>
            /* Set display to none for image*/
        </style>
        <div id="main">
            <div class="page-heading">
                <div class="page-title mb-3">
                    <div class="row">
                        <div class="col-12 col-md-6 order-md-1 order-last">
                            <h3><a href="<%= baseUrl %>dashboard" class="text-primary"><i
                                        class="fas fa-arrow-left me-2"></i></a> Donators</h3>
                        </div>
                        <div class="col-12 col-md-6 order-md-2 order-first">
                            <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="<%= baseUrl %>dashboard">Dashboard</a></li>

                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>

                <section class="section">
                    <!-- Create Donator Section -->
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Create New Donator</h4>
                        </div>
                        <div class="card-body">
                            <form id="createDonatorForm">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label for="tgidInput" class="form-label">Telegram Username <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="tgidInput" name="tgid" placeholder="e.g., john_doe" required>
                                            <small class="form-text text-muted">Enter the Telegram username (without @)</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label for="countrySelect" class="form-label">Country <span class="text-danger">*</span></label>
                                            <select class="form-control" id="countrySelect" name="country" required>
                                                <option value="">Select a country...</option>
                                            </select>
                                            <small class="form-text text-muted">Select the country from the list</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-plus-circle"></i> Create Donator
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </section>

                <section class="section">
                    <div class="card">

                        <div class="category-filter">
                            <label>
                                Country: 
                                <select id="categoryFilter" class="form-control">
                                  <option value="" <%= selectedCountry === '' ? 'selected' : '' %>>Show All</option>
                                  <% var i=1; country1.forEach(function(v) { %>
                                    <option value="<%= v._id.country %>" <%= selectedCountry === v._id.country ? 'selected' : '' %>><%= v._id.country %></option>
                                    <% }) %>
                                </select>        
                            </label>        
                          </div>

                        <div class="card-body">
                            <div class="dataTable-container">
                                <div class="success" style="display: none;"></div>
                                <table class="table table-striped dataTable-table" id="filterTable">
                                    <thead>
                                        <tr>
                                        <th>No.</th>
                                        <th>Member Id</th>
                                        <th>UserName</th>
                                        <th>TG-id</th>
                                        <th>Country</th>
                                        <th>Donator On Date</th>
                                        <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% var i=1; donateduser.forEach(function(v) { %>
                                            <% if( v.usertype == 2) { %>
                                            <tr data-id="<%= v._id%>">
                                                <td><span class="name-field">
                                                    <%= i %>
                                                </span></td>
                                                <td><span class="name-field">
                                                        <%= v.memberid%>
                                                    </span></td>
                                                <td><span class="name-field">
                                                        <%= v.username%>
                                                    </span></td>
                                                <td><span class="name-field">
                                                        <a href="https://t.me/<%= v.tgid%>"> https://t.me/<%= v.tgid%></a>
                                                    </span></td>
                                                <td><span class="name-field">
                                                        <%= v.country%>
                                                    </span></td>
                                                <td><span class="name-field">
                                                    <%= v.donatorOnDate ? moment(v.donatorOnDate).format('DD-MM-YYYY') : 'N/A' %>
                                                    </span></td>
                                                <td>
                                                    <a
                                                        href="<%= baseUrl %>admin/donateduser/view/<%= v._id %>"
                                                        class="btn btn-primary btn-sm"
                                                    >
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <button type="button" data-id="<%= v._id %>" id="refresh"
                                                        class="btn icon icon-left btn-danger btn-sm delete-data"><i
                                                            class="bi bi-trash"></i> </button>
                                                </td>
                                            </tr>
                                            <% i++ %>
                                        <% }%>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
            </div>
        </div>

        </section>
        <footer>
            <div class="footer clearfix mb-0 text-muted">
                <div class="float-start">
                    <p>2023 &copy; All rights are reserved</p>
                </div>
                
            </div>
        </footer>
        </div>

        <div class="modal fade bd-example-modal-lg" id="viewQRCode" tabindex="-1" role="dialog"
            aria-labelledby="myLargeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title w-100" id="exampleModalLabel">
                            QRcode Preview
                        </h5>
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <!--Modal body with image-->
                    <div class="modal-body">
                        <img src="" class="imagepreview" id="image" width="100%" height="265px">
                    </div>
                    <!-- <div class="modal-footer">
                        <button type="button" class="btn btn-danger"
                            data-bs-dismiss="modal" >
                            Close
                        </button>
                    </div> -->
                </div>
            </div>
        </div>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script type="application/json" id="server-data"><%- JSON.stringify({ baseUrl: baseUrl }) %></script>

        <script>
            const serverData = JSON.parse(document.getElementById('server-data').textContent);
            const baseUrl = serverData.baseUrl;

            // Fetch and populate countries on page load
            async function loadCountries() {
                try {
                    const response = await fetch('https://telegramdirectory.org/api/getCountry');
                    const data = await response.json();
                    
                    const countrySelect = document.getElementById('countrySelect');
                    
                    // Clear existing options (keep the placeholder)
                    countrySelect.innerHTML = '<option value="">Select a country...</option>';
                    
                    // Add countries from API
                    if (data.CountryData && Array.isArray(data.CountryData)) {
                        data.CountryData.forEach(country => {
                            const option = document.createElement('option');
                            option.value = country.country_name;
                            option.textContent = country.country_name;
                            countrySelect.appendChild(option);
                        });
                    }
                } catch (error) {
                    console.error('Error loading countries:', error);
                    Swal.fire('Warning!', 'Could not load countries list. Please try again.', 'warning');
                }
            }

            // Load countries when DOM is ready
            document.addEventListener('DOMContentLoaded', loadCountries);

            // Handle create donator form submission
            document.getElementById('createDonatorForm').addEventListener('submit', async function(e) {
                e.preventDefault();

                const formData = {
                    tgid: document.getElementById('tgidInput').value.trim(),
                    country: document.getElementById('countrySelect').value.trim()
                };

                // Basic validation
                if (!formData.tgid || !formData.country) {
                    Swal.fire('Error!', 'Please fill in all fields', 'error');
                    return;
                }

                try {
                    const response = await fetch(baseUrl + 'create-donator', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(formData)
                    });

                    const result = await response.json();

                    if (result.success) {
                        Swal.fire(
                            'Success!',
                            'Donator user created successfully!',
                            'success'
                        ).then(() => {
                            document.getElementById('createDonatorForm').reset();
                            // Refresh the page to show the new donator
                            location.reload();
                        });
                    } else {
                        Swal.fire(
                            'Error!',
                            result.message || 'Failed to create donator user',
                            'error'
                        );
                    }
                } catch (error) {
                    console.error('Error:', error);
                    Swal.fire(
                        'Error!',
                        error.message || 'An unexpected error occurred',
                        'error'
                    );
                }
            });
        </script>

        <script>
            //   $(document).ready(function() {
            //     var table = $('#table1').DataTable({
            //       "bSort": false
            //     });
            //   });
            $("document").ready(function () {
                  $("#filterTable").dataTable({
                    "searching": true
                  });
                  var table = $('#filterTable').DataTable();
                  $("#filterTable_filter.dataTables_filter").prepend($(".category-filter"));
                  
                  var categoryIndex = 5;
                  $("#categoryFilter").change(function (e) {
                    var selectedCountry = $(this).val();
                    var url = window.location.pathname;
                    if (selectedCountry) {
                      url += '?country=' + encodeURIComponent(selectedCountry);
                    } else {
                      url = window.location.pathname;
                    }
                    window.location.href = url;
                  });
                  table.draw();
                });
            </script>

        <script>
            $(document).ready(function () {
                var table = $('#table1').DataTable( {
                        "bSort": false
                    } );
            });
            $(".btnID").on("click", function () {                
                var images = $(this).find('.image').prop('src');

                $('#viewQRCode #image').prop('src', images);
                $('#viewQRCode').modal('show');
            });
        </script>
<script>
    $(document).on('click', '.delete-data', function () {
        var id = $(this).data("id");
        var baseUrl = '<%= baseUrl %>'
        swal({
            title: "Are you sure?",
            text: "You want to delete this User?",
            icon: "warning",
            buttons: true,
            dangerMode: true,
        })
            .then((willDelete) => {
                if (willDelete) {
                    $.ajax({
                        type: "GET",
                        url: `${baseUrl}admin/deletedonateduser?id=${id}`,
                        dataType: "json",
                        statusCode: {
                            200: function (xhr) {
                                dataResult = xhr;
                                $(`tr[data-id="${id}"]`).remove();
                                console.log(dataResult.message)
                                Toastify({
                                    text: "Deleted successfully...",
                                    duration: 3000,
                                    newWindow: true,
                                    close: true,
                                    gravity: "top", // `top` or `bottom`
                                    position: "right", // `left`, `center` or `right`
                                    stopOnFocus: true, // Prevents dismissing of toast on hover
                                    style: {
                                        background: "#ff2c2c",
                                    },
                                }).showToast();
                            }
                        },
                    });
                }
            });
    });
    let isTost = '<%= session.isTost %>'
    let msg = '<%= session.tostMsg %>'
    let tostBackground = '<%= session.tostBackground %>'
    if (isTost == "true") {
        Toastify({
            text: msg,
            duration: 3000,
            newWindow: true,
            close: true,
            gravity: "top", // `top` or `bottom`
            position: "right", // `left`, `center` or `right`
            stopOnFocus: true, // Prevents dismissing of toast on hover
            style: {
                background: tostBackground,
            },
        }).showToast();
        '<%= session.isTost = "false"%>'
    }
</script>


