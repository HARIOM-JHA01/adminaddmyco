<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link rel="stylesheet" href="../../assets/css/forever.css">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script>
  </head>
  <body>
    <div class="container ">

      <div class="tags">
          <div class="offer text-center mt-5">
        <div class="btn-group take " role="group" aria-label="Basic radio toggle button group">
          <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked>
          <label class="btn btn-outline-primary shows_tag p-2  px-4" for="btnradio1" id="btn1">Toncoin Wallet</label>
        
          <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off">
          <label class="btn btn-outline-primary shows_tag p-2 px-5" for="btnradio2" id="btn2">Paypal</label>

        </div>
      </div>
      <div class="row give_me">
        <div class="col-lg-6 col-12 m-auto text-center mt-5">
    

    <div class="mind">
        <h5>Scan OR Code</h5>
        <img src="../../assets/images/wallet-transfer.png" height="200px" alt="">
        <h6 class="mt-3 text-white">Copy Wallet Address</h6>
        <p class="text-white">EQB69uLvi3juuaZukqwtm_<br>cl-6UnkhlcLmwy6iDxIJaop_CE </p>
    </div>
        </div>



        <div class="col-lg-6 col-12 mt-4"> 
   
    <div class="mind m-auto">
      <h5 class="mt-2 mb-4 text-center">Submit transaction details</h5>
      <div class="row ">
        <div class="col-10 px-0 m-auto list_input">
           <form action="<%= baseUrl %>purchasemembership" method="post">
            <div class="input-group mb-3">
              <input type="text" id="period" class="form-control"  onkeyup="eventHandler(this)" name="period" placeholder="membership period" aria-label="Username" aria-describedby="basic-addon1">
              <% if(typeof errors == "object") { %><p style="color: red;" class="period">
                <%= errors.period %></p> <% } %>
            </div>
            <div class="input-group mb-3">
              <input type="text" id="firstname" class="form-control" onkeyup="eventHandler(this)" name="firstname" placeholder="payer First Name" aria-label="Username" aria-describedby="basic-addon1">
              <% if(typeof errors == "object") { %><p style="color: red;" class="firstname">
                <%= errors.firstname %></p> <% } %>
            </div>
             <div class="input-group mb-3">
              <input type="text" id="lastname" class="form-control" onkeyup="eventHandler(this)" name="lastname" placeholder="Payer Last Name" aria-label="Username" aria-describedby="basic-addon1">
              <% if(typeof errors == "object") { %><p style="color: red;" class="lastname">
                <%= errors.lastname %></p> <% } %>
            </div>
            <div class="input-group mb-3">
              <input type="text" id="address" class="form-control" onkeyup="eventHandler(this)" name="address" placeholder="Wallet address" aria-label="Username" aria-describedby="basic-addon1">
              <% if(typeof errors == "object") { %><p style="color: red;" class="address">
                <%= errors.address %></p> <% } %>
            </div>
            <div class="input-group mb-3">
              <input type="text" id="transaction" class="form-control" onkeyup="eventHandler(this)" name="transaction" placeholder="Transaction" aria-label="Username" aria-describedby="basic-addon1">
              <% if(typeof errors == "object") { %><p style="color: red;" class="transaction">
                <%= errors.transaction %></p> <% } %>
            </div>
            <div class="input-group mb-3">
              <input type="text" id="transaction" class="form-control" placeholder="mm/dd/yyyy" aria-label="Username" aria-describedby="basic-addon1">
              <% if(typeof errors == "object") { %><p style="color: red;" class="transaction">
                <%= errors.transaction %></p> <% } %>
            </div>
            <div class="input-group mb-3">
              <input type="text" class="form-control" placeholder="5 Toncoin" aria-label="Username" aria-describedby="basic-addon1">
            </div>
            <div class="in_to text-start mb-3">
              <button class="btn btn-primary  ">Submit</button>
            </div>
           </form>
        </div>
      </div>


      
    </div>
  </div>
 
</div>


        <div class="row your_mind mt-5">
          <div class="col-lg-6 col-12">
            <div class="mind m-auto">
              <h5 class="mt-2 mb-4 text-center">Submit transaction details</h5>
              <div class="row ">
                <div class="col-10 px-0 m-auto list_input">
                   <form action="">
                    <div class="input-group mb-3">
                      <input type="text" class="form-control" placeholder="membership period" aria-label="Username" aria-describedby="basic-addon1">
                    </div>
                    <div class="input-group mb-3">
                      <input type="text" class="form-control" placeholder="Payer First Name" aria-label="Username" aria-describedby="basic-addon1">
                    </div>
                     <div class="input-group mb-3">
                      <input type="text" class="form-control" placeholder="Payer Last Name" aria-label="Username" aria-describedby="basic-addon1">
                    </div>
                    <div class="input-group mb-3">
                      <input type="text" class="form-control" placeholder="Paypal id" aria-label="Username" aria-describedby="basic-addon1">
                    </div>
                    <div class="input-group mb-3">
                      <input type="text" class="form-control" placeholder="Transaction ID" aria-label="Username" aria-describedby="basic-addon1">
                    </div>
                    <div class="input-group mb-3">
                      <input type="text" class="form-control" placeholder="mm/dd/yyyy" aria-label="Username" aria-describedby="basic-addon1">
                    </div>
                    <div class="input-group mb-3">
                      <input type="text" class="form-control" placeholder="9.9 USD" aria-label="Username" aria-describedby="basic-addon1">
                    </div>
                    <div class="in_to text-end mb-3">
                      <button class="btn btn-primary  ">Submit</button>
                    </div>
                   </form>
                </div>
              </div>
        
        
              
            </div>
          </div>

          <div class="col-6 your_tags m-auto text-center mt-5">
                 <h5>Make deposit here</h5>
                 <a href="" class="think_over"><p>Paypal.me/Bluemarketer</p></a>
          </div>
        </div>





</div>
</div>

 
 
 
 
  <script src="forever.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN" crossorigin="anonymous"></script>
  </body>
</html>