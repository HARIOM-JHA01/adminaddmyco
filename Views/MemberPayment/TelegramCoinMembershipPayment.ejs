<%- include('../Layout/Header') %>
<link
  rel="stylesheet"
  href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css"
/>
<%- include('../Layout/Sidebar') %>
<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3>
            <a href="<%= baseUrl %>admin/dashboard" class="text-primary"
              ><i class="fas fa-arrow-left me-2"></i></a
            >Telegram Coin Payment
          </h3>
        </div>
        <div
          class="col-12 col-md-6 order-md-2 order-first d-flex justify-content-end align-items-center"
        >
          <nav
            aria-label="breadcrumb"
            class="breadcrumb-header float-start float-lg-end me-4 mb-0"
          >
            <ol class="breadcrumb" style="margin-bottom: 0px">
              <li class="breadcrumb-item">
                <a href="<%= baseUrl %>admin/dashboard">Dashboard</a>
              </li>
            </ol>
          </nav>
          <a href="<%= baseUrl %>admin/exporttelegramcoinpayment"
            ><button type="button" class="btn btn-primary btn-sm">
              Export Data
            </button></a
          >
        </div>
      </div>
    </div>
    <section class="section">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-striped mb-0" id="payment_table">
            <thead>
              <tr>
                <th>No.</th>
                <th>Member Id</th>
                <th>UserName</th>
                <th>Telegram Id</th>
                <th>Tenure (in years)</th>
                <th>Amount (Coin)</th>
                <th>Payment Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% var i=1; telegramCoinPayments.forEach(function(v) { %>
              <tr data-id="<%= v._id%>">
                <td><span class="name-field"><%= i %></span></td>
                <td><span class="name-field"><%= v.member_id%></span></td>
                <td><span class="name-field"><%= v.username%></span></td>
                <td>
                  <span class="name-field"
                    ><a href="https://t.me/<%= v.tgid%>">
                      https://t.me/<%= v.telegram_id%></a
                    ></span
                  >
                </td>
                <td><span class="name-field"><%= v.tenure%> Years</span></td>
                <td><span class="name-field"><%= v.amount%> Coin</span></td>
                <td><span class="name-field"><%= v.date%></span></td>
                <td>
                  <% if (v.status == 0) { %>
                  <button
                    class="btn btn-success btn-sm approve-btn"
                    data-id="<%= v._id%>"
                  >
                    Approve
                  </button>
                  <button
                    class="btn btn-warning btn-sm reject-btn"
                    data-id="<%= v._id%>"
                  >
                    Reject
                  </button>
                  <button
                    class="btn btn-danger btn-sm delete-btn"
                    data-id="<%= v._id%>"
                  >
                    Delete
                  </button>
                  <% } else { %>
                  <span>N/A</span>
                  <% } %>
                </td>
              </tr>

              <% i++ %> <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</div>
<%- include('../Layout/Footer') %>
