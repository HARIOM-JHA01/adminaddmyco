        <script>
            $(document).on('click', '.delete-data', function () {
                var id = $(this).data("id");
                var baseUrl = '<%= baseUrl %>'
                swal({
                    title: "Are you sure?",
                    text: "You want to delete this paypal?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                })
                    .then((willDelete) => {
                        if (willDelete) {
                            $.ajax({
                                type: "GET",
                                url: `${baseUrl}admin/deletetoncoin?id=${id}`,
                                dataType: "json",
                                statusCode: {
                                    200: function (xhr) {
                                        dataResult = xhr;
                                        $(`tr[data-id="${id}"]`).remove();
                                        console.log(dataResult.message)
                                        Toastify({
                                            text: "Deleted successfully...",
                                            duration: 3000,
                                            newWindow: true,
                                            close: true,
                                            gravity: "top", // `top` or `bottom`
                                            position: "right", // `left`, `center` or `right`
                                            stopOnFocus: true, // Prevents dismissing of toast on hover
                                            style: {
                                                background: "#ff2c2c",
                                            },
                                        }).showToast();
                                    }
                                },
                            });
                        }
                    });
            });
            let isTost = '<%= session.isTost %>'
            let msg = '<%= session.tostMsg %>'
            let tostBackground = '<%= session.tostBackground %>'
            if (isTost == "true") {
                Toastify({
                    text: msg,
                    duration: 3000,
                    newWindow: true,
                    close: true,
                    gravity: "top", // `top` or `bottom`
                    position: "right", // `left`, `center` or `right`
                    stopOnFocus: true, // Prevents dismissing of toast on hover
                    style: {
                        background: tostBackground,
                    },
                }).showToast();
                '<%= session.isTost = "false"%>'
            }
        </script>
