<%- include('../Layout/Header') %>
<link rel="stylesheet" href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css">
import session from "express-session"

<%- include('../Layout/Sidebar') %>
<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last ">
          <h3><a href="<%= baseUrl %>admin/dashboard" class="text-primary"><i class="fas fa-arrow-left me-2"></i></a>Stripe Payment</h3>
        </div>
        <div class="col-12 col-md-6 order-md-2 order-first d-flex justify-content-end align-items-center">
          <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end me-4 mb-0">
            <ol class="breadcrumb" style="margin-bottom: 0px;">
              <li class="breadcrumb-item"><a href="<%= baseUrl %>admin/dashboard">Dashboard</a>
              </li>
            </ol>
          </nav>
          <a href="<%= baseUrl %>admin/exportstripedetail"><button type="button" class="btn btn-primary btn-sm ">Export Data</button></a>
        </div>
      </div>
    </div>
    <section class="section">
      <div class="card-body">     
       
        <div class="table-responsive">
          <table table class="table table-striped mb-0" id="payment_table" class="data-table">
            <thead>
              <tr>
                <th>No.</th>
                <th>Member Id</th>
                <th>UserName</th>
                <th>Telegram Id</th>
                <th>Ternuer (in years)</th>
                <th>Amount(HKD$)</th>
                <th>Payment Date</th>
                <th>Action</th>
              </tr>
            </thead>
            
              <tbody>
              <% var i=1; membershipstripe.forEach(function(v) { %>
             
              <tr data-id="<%= v._id%>">
                <td><span class="name-field">
                    <%= i %>
                  </span></td>
                <td><span class="name-field">
                    <%= v.member_id%>
                  </span></td>
                <td><span class="name-field">
                    <%= v.username%>
                  </span></td>
                <td><span class="name-field">
                    <a href="https://t.me/<%= v.tgid%>"> https://t.me/<%= v.telegram_id%></a>
                  </span></td>
                <td><span class="name-field">
                      <%= v.tenure%> Years
                  </span></td>
                <td><span class="name-field">
                    <%= v.amount%> HK$
                  </span></td>
                  <td><span class="name-field">
                    <%= v.date%>
                  </span></td>
                <td>
                  <button type="button" data-id="<%= v._id %>" id="refresh" class="btn icon icon-left btn-danger btn-sm delete-data"><i class="bi bi-trash"></i> </button>
              </tr>
              <% i++ %>
            
              <% }) %>
            </tbody>
            
          </table>
        </div>
      </div>
  </div>
</div>

</section>
<footer>
  <div class="footer clearfix mb-0 text-muted">
    <div class="float-start">
      <p>2023 &copy; All rights are reserved</p>
    </div>

  </div>
</footer>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>







<script>
  $(document).on('click', '.delete-data', function() {
    var id = $(this).data("id");
    var baseUrl = '<%= baseUrl %>'
    swal({
        title: "Are you sure?",
        text: "You want to delete this delete stripe pyment?",
        icon: "warning",
        buttons: true,
        dangerMode: true,
      })
      .then((willDelete) => {
        if (willDelete) {
          $.ajax({
            type: "GET",
            url: `${baseUrl}admin/deletestripepayment?id=${id}`,
            dataType: "json",
            statusCode: {
              200: function(xhr) {
                dataResult = xhr;
                $(`tr[data-id="${id}"]`).remove();
                console.log(dataResult.message)
                window.location.reload()
                Toastify({
                  text: "Deleted successfully...",
                  duration: 3000,
                  newWindow: true,
                  close: true,
                  gravity: "top", // `top` or `bottom`
                  position: "right", // `left`, `center` or `right`
                  stopOnFocus: true, // Prevents dismissing of toast on hover
                  style: {
                    background: "#ff2c2c",
                  },
                }).showToast();
              }
            },
          });
        }
      });
  });
</script>
<script>
  let isTost = '<%= session.isTost %>'
  let msg = '<%= session.tostMsg %>'
  let tostBackground = '<%= session.tostBackground %>'
  if (isTost == "true") {
    Toastify({
      text: msg,
      duration: 3000,
      newWindow: true,
      close: true,
      gravity: "top", // `top` or `bottom`
      position: "right", // `left`, `center` or `right`
      stopOnFocus: true, // Prevents dismissing of toast on hover
      style: {
        background: tostBackground,
      },
    }).showToast();
    '<%= session.isTost = "false"%>'
  }
</script>

