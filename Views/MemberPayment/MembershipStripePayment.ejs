      location.href = jQuery(this).val();
    })
  })
</script>

<script>
  $(document).on('click', '.approve_btn', function() {
    var id = $(this).data("id");
    var baseUrl = '<%= baseUrl %>'
    swal({
        title: "Are you sure?",
        text: "You Want to this premium user?",
        icon: "warning",
        buttons: true,
        dangerMode: true,
      })
      .then((willDelete) => {
        if (willDelete) {
          $.ajax({
            type: "GET",
            url: `${baseUrl}admin/approvepremium?id=${id}`,
            dataType: "json",
            statusCode: {
              200: function(xhr) {
               location.reload(true);
              }
            }
          });
        }
      });
  });
</script>
