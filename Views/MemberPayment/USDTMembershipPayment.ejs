<%- include('../Layout/Header') %>
<link
  rel="stylesheet"
  href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css"
/>
<%- include('../Layout/Sidebar') %>
<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3>
            <a href="<%= baseUrl %>admin/dashboard" class="text-primary"
              ><i class="fas fa-arrow-left me-2"></i></a
            >USDT Payment
          </h3>
        </div>
        <div
          class="col-12 col-md-6 order-md-2 order-first d-flex justify-content-end align-items-center"
        >
          <nav
            aria-label="breadcrumb"
            class="breadcrumb-header float-start float-lg-end me-4 mb-0"
          >
            <ol class="breadcrumb" style="margin-bottom: 0px">
              <li class="breadcrumb-item">
                <a href="<%= baseUrl %>admin/dashboard">Dashboard</a>
              </li>
            </ol>
          </nav>
          <a href="<%= baseUrl %>admin/exportusdtpayment"
            ><button type="button" class="btn btn-primary btn-sm">
              Export Data
            </button></a
          >
        </div>
      </div>
    </div>
    <section class="section">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-striped mb-0" id="payment_table">
            <thead>
              <tr>
                <th>No.</th>
                <th>Member Id</th>
                <th>UserName</th>
                <th>Telegram Id</th>
                <th>Transaction ID</th>
                <th>Wallet Address</th>
                <th>Tenure (in years)</th>
                <th>Amount (USDT)</th>
                <th>Status</th>
                <th>Payment Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% var i=1; usdtPayments.forEach(function(v) { %>
              <tr data-id="<%= v._id%>">
                <td><span class="name-field"><%= i %></span></td>
                <td><span class="name-field"><%= v.member_id%></span></td>
                <td><span class="name-field"><%= v.username%></span></td>
                <td>
                  <span class="name-field"
                    ><a href="https://t.me/<%= v.telegram_id%>">
                      https://t.me/<%= v.telegram_id%></a
                    ></span
                  >
                </td>
                <td><span class="name-field"><%= v.transactionId%></span></td>
                <td><span class="name-field"><%= v.walletAddress%></span></td>
                <td><span class="name-field"><%= v.tenure%> Years</span></td>
                <td><span class="name-field"><%= v.amount%> USDT</span></td>
                <td>
                  <% if (v.status == 0) { %>
                  <span class="badge bg-warning">Pending</span>
                  <% } else if (v.status == 1) { %>
                  <span class="badge bg-success">Approved</span>
                  <% } else if (v.status == 2) { %>
                  <span class="badge bg-danger">Rejected</span>
                  <% } %>
                </td>
                <td><span class="name-field"><%= v.date%></span></td>
                <td>
                  <% if (v.status == 0) { %>
                  <button
                    class="btn btn-success btn-sm approve-btn"
                    data-id="<%= v._id%>"
                  >
                    Approve
                  </button>
                  <button
                    class="btn btn-warning btn-sm reject-btn"
                    data-id="<%= v._id%>"
                  >
                    Reject
                  </button>
                  <button
                    class="btn btn-danger btn-sm delete-btn"
                    data-id="<%= v._id%>"
                  >
                    Delete
                  </button>
                  <% } else { %>
                  <span>N/A</span>
                  <% } %>
                </td>
              </tr>
              <% i++ %> <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  const baseUrl = "<%= baseUrl %>";

  $(document).ready(function () {
    $("#payment_table").DataTable();

    // Approve payment
    $(".approve-btn").on("click", function () {
      const id = $(this).data("id");
      Swal.fire({
        title: "Approve Payment?",
        text: "This will upgrade the user to premium and extend their membership.",
        icon: "question",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, approve it!",
      }).then((result) => {
        if (result.isConfirmed) {
          $.ajax({
            url: `${baseUrl}admin/approveusdtpayment?id=${id}`,
            method: "GET",
            success: function (response) {
              Swal.fire(
                "Approved!",
                "Payment has been approved.",
                "success"
              ).then(() => location.reload());
            },
            error: function (err) {
              Swal.fire("Error!", "Failed to approve payment.", "error");
            },
          });
        }
      });
    });

    // Reject payment
    $(".reject-btn").on("click", function () {
      const id = $(this).data("id");
      Swal.fire({
        title: "Reject Payment?",
        text: "This will mark the payment as rejected.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Yes, reject it!",
      }).then((result) => {
        if (result.isConfirmed) {
          $.ajax({
            url: `${baseUrl}admin/rejectusdtpayment?id=${id}`,
            method: "GET",
            success: function (response) {
              Swal.fire(
                "Rejected!",
                "Payment has been rejected.",
                "success"
              ).then(() => location.reload());
            },
            error: function (err) {
              Swal.fire("Error!", "Failed to reject payment.", "error");
            },
          });
        }
      });
    });

    // Delete payment
    $(".delete-btn").on("click", function () {
      const id = $(this).data("id");
      Swal.fire({
        title: "Delete Payment?",
        text: "This action cannot be undone!",
        icon: "error",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Yes, delete it!",
      }).then((result) => {
        if (result.isConfirmed) {
          $.ajax({
            url: `${baseUrl}admin/deleteusdtpayment?id=${id}`,
            method: "GET",
            success: function (response) {
              Swal.fire(
                "Deleted!",
                "Payment has been deleted.",
                "success"
              ).then(() => location.reload());
            },
            error: function (err) {
              Swal.fire("Error!", "Failed to delete payment.", "error");
            },
          });
        }
      });
    });
  });
</script>
<%- include('../Layout/Footer') %>
