	<script>
		$(".addSoacial").click(function () {
			const socialMedia = $(this).data("name");
			const checkAvail = $("#socialContainer").find(`.${socialMedia}`).length
			console.log("dfdg", checkAvail);
			const appendHtml = `<div class="col-6 socialLink ${socialMedia}">
    							<div class="form-group mb-1">
    								<label class="d-none">${socialMedia}</label>
									<div class="position-relative social-input">
    								<input type="text" name="${socialMedia}" id="${socialMedia}" class="form-control" placeholder="${socialMedia}" value=""/>								
									<button type="button" class="btn btn-remove-social">X</button>
									</div> 
    							</div>    							
    						</div>`;

			if (checkAvail == 0) {
				$("#socialContainer").append(appendHtml);
			}
		});

		$(document).on("click", ".btn-remove-social", function () {
			$(this).parents(".socialLink").remove();
		})
	</script>
	<%- include('../Elements/Footer') %>