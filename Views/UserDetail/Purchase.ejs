<!doctype html>
<html lang="en">    
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link rel="stylesheet" href="../../assets/css/forever.css" />    
	<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.6.1/css/bootstrap-datepicker.min.css'>
	
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">

  <link rel="stylesheet" href="<%= baseUrl %>assets/css/datepicker.css">  
  <link rel="stylesheet" href="<%= baseUrl %>assets/user/css/duDatepicker.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">
    
</head>

<body>
    <div class="container ">
      
        <div class="tags">
                <input type="hidden" name="id" value="<%= membership._id %>"> 
            <p> You have selected to upgrade your free membership to Business membership for a tenure of <%= membership.periodofmembership %>Years for the same You need to Deposite <%= membership.paypal %>
                in our Paypal account or <%= membership.toncoin %> in our toncoin wallet.
                Details are mentioned below  , After deposting amount submit your transaction details in given below form </p>
               
            <ul class="nav nav-pills justify-content-center mb-3 mt-5 purchase-pills" id="pills-tab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pills-home-tab" data-bs-toggle="pill"
                        data-bs-target="#pills-home" type="button" role="tab" aria-controls="pills-home"
                        aria-selected="true">Toncoin Wallet</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-profile-tab" data-bs-toggle="pill"
                        data-bs-target="#pills-profile" type="button" role="tab" aria-controls="pills-profile"
                        aria-selected="false">Paypal</button>
                </li>
            </ul>
            <div class="tab-content" id="pills-tabContent">
                <div class="tab-pane fade show active" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab"
                    tabindex="0">
                    <div class="row give_me">
                        <div class="col-lg-6 col-12 m-auto text-center mt-5">
                            <div class="mind">
                                <h5>Scan OR Code</h5>
                                <img src="assets/images/faces/qr.jpg" height="200px" alt="">
                                <h6 class="mt-3 ">Copy Wallet Address</h6>
                                <p class="">EQB69uLvi3juuaZukqwtm_<br>cl-6UnkhlcLmwy6iDxIJaop_CE </p>
                            </div>
                        </div>
                        <div class="col-lg-6 col-12 mt-4">
                            
                            <div class="mind m-auto">
                                <h5 class="mt-2 mb-4 text-center">Submit transaction details</h5>
                                <div class="row ">
                                    <div class="col-10 px-0 m-auto list_input">
                                        <form action="<%= baseUrl %>purchasetoncoin"method="post" enctype="multipart/form-data">
                                            <input type="hidden" name="id" value="<%= membership._id %>">  
                                            
                                            <div class="input-group mb-3">
                                                <input type="text" name = "membershiperiod" id ="membershiperiod"class="form-control" placeholder="membership period"
                                                    aria-label="Username" aria-describedby="basic-addon1"value="<%=membership.periodofmembership %> Years" readonly>
                                            </div>
                                            <div class="input-group mb-3">
                                                <input type="text" name="firstname" id="firstname" class="form-control" placeholder="payer First Name"
                                                    aria-label="Username" aria-describedby="basic-addon1">
                                            </div>
                                            <div class="input-group mb-3">
                                                <input type="text" name="lastname" id="lastname" class="form-control" placeholder="Payer Last Name"
                                                    aria-label="Username" aria-describedby="basic-addon1">
                                            </div>
                                            <div class="input-group mb-3">
                                                <input type="text" name="address" id="address" class="form-control" placeholder="Wallet address"
                                                    aria-label="Username" aria-describedby="basic-addon1">
                                            </div>
                                            <div class="input-group mb-3">
                                                <input type="text" name="transactionid" id="transactionid"  class="form-control" placeholder="Transaction"
                                                    aria-label="Username" aria-describedby="basic-addon1">
                                            </div>
                                            <div class="input-group mb-3">
                                                <input type="text" name="date" id="date" class="date form-control" placeholder="mm/dd/yyyy"
                                                    aria-label="Username" aria-describedby="basic-addon1">
                                            </div>
                                           
                                                    
                                            <div class="input-group mb-3">
                                                <input type="text" name="toncoin" id ="toncoin"class="form-control" placeholder="5 Toncoin" 
                                                    aria-label="Username" aria-describedby="basic-addon1" value="<%= membership.toncoin %>"readonly>
                                            </div>
                                            <div class="in_to text-start mb-3">
                                                <button class="btn btn-primary  ">Submit</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>



                            </div>
                        </div>

                    </div>
                </div>
                <div class="tab-pane fade" id="pills-profile" role="tabpanel" aria-labelledby="pills-profile-tab"
                    tabindex="0">
                    <div class="row your_mind mt-5">
                        <div class="col-lg-6 col-12">
                            <div class="mind m-auto">
                                <h5 class="mt-2 mb-4 text-center">Submit transaction details</h5>
                                <div class="row ">
                                    <div class="col-10 px-0 m-auto list_input">
                                        <form action="<%= baseUrl %>purchasepaypal"method="post" enctype="multipart/form-data">
                                            <input type="hidden" name="id" value="<%= membership._id %>">  
                                            <div class="input-group mb-3">
                                                <input type="text"  name="membershiperiod" id="membershiperiod"   class="form-control" placeholder="membership period"
                                                    aria-label="Username" aria-describedby="basic-addon1" value="<%= membership.periodofmembership %> Years" readonly>
                                            </div>
                                            <div class="input-group mb-3">
                                                <input type="text"  name="firstname" id="firstname" class="form-control" placeholder="Payer First Name"
                                                    aria-label="Username" aria-describedby="basic-addon1">
                                            </div>
                                            <div class="input-group mb-3">
                                                <input type="text"  name="lastname" id="lastname"   class="form-control" placeholder="Payer Last Name"
                                                    aria-label="Username" aria-describedby="basic-addon1">
                                            </div>
                                            <div class="input-group mb-3">
                                                <input type="text" name="paypalid" id="paypalid"  class="form-control" placeholder="Paypal id"
                                                    aria-label="Username" aria-describedby="basic-addon1">
                                            </div>
                                            <div class="input-group mb-3">
                                                <input type="text"  name="transactionid" id="transactionid" class="form-control" placeholder="Transaction ID"
                                                    aria-label="Username" aria-describedby="basic-addon1">
                                            </div>
                                            <div class="input-group mb-3">
                                                <input type="text" name ="date" id="paypaldate"  class=" date form-control" placeholder="mm/dd/yyyy"
                                                    aria-label="Username" aria-describedby="basic-addon1">
                                            </div>
                                            <div class="input-group mb-3">
                                                <input type="text"  name= "paypal" id=""  class="form-control" placeholder="9.9 USD"
                                                    aria-label="Username" aria-describedby="basic-addon1" value="<%=membership.paypal %>" readonly>
                                            </div>
                                            <div class="in_to text-end mb-3">
                                                <button class="btn btn-primary  ">Submit</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6 your_tags m-auto text-center mt-5">
                            <h5>Make deposit here</h5>
                            <a href="" class="think_over">
                                <p>Paypal.me/Bluemarketer</p>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
       
    </div>


 
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.2/jquery.validate.min.js"></script>
    <script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
    <script src='https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.14.1/moment.min.js'></script>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN"
        crossorigin="anonymous"></script>
        <!-- <script src="<%= baseUrl %>assets/js/duDatepicker.js"></script> -->
  <script  src="<%= baseUrl %>assets/js/datepicker.js"></script>
  <script>
    //     $(document).ready(function() {
    //       $('.timepicker').mdtimepicker(); //Initializes the time picker
    //   });
  
      new Lightpick({
          field: document.getElementById('date'),          
          minDate: moment().startOf('today'),
          singleDate: true,
      });
      new Lightpick({
          field: document.getElementById('paypaldate'),          
          minDate: moment().startOf('today'),
          singleDate: true,
      });
  </script>
  </body>
  </html>


