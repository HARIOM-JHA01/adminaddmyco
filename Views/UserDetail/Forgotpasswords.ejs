<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ForgotPassword</title>
  <link rel="stylesheet" href="../../assets/css/forgot password.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">

</head>

<body>

  <div class="container px-0 mt-4">

    <div class="cold d-flex justify-content-center">
      <h1>AddMy.Co</h1>
      <img src="assets/images/telegram.png" height="40px" class="m-3 px-3 " alt="">

    </div>


    <div class="container-fluid mt-3 ">
      <div class="into ">
        <div class="phone  ">



          <div class="more ">
            <div class="think_in view_space">
              <form action="<%= baseUrl %>forgotpassword" method="post">



                <img src="assets/images/Asset 2@3x.png" height="140px" class="hold_in mt-5" alt="">
                <h5 class="text-center mt-4 in_color">forgot password </h5>
                <div class="row justify-content-center ">
                  <div class="col-10  ">
                    <div class="shows mt-4">
                      <div class="input-group mb-2 text_bold control_tag">
                        <input type="text" class="form-control text-center " name="email"
                          placeholder="Enter username/ Email to get your password" aria-label="Username"
                          aria-describedby="basic-addon1">
                      </div>
                    </div>
                  </div>
                </div>


                <div class="row justify-content-center">
                  <div class="col-10    pb-2">

                    <button class="over_button p-2 ">Submit</button>
                  </div>
                </div>
              </form>



              <div class="bold">
                <p class="d-none">Lorem ipsum dolor sit amet.</p>
              </div>

            </div>

          </div>
        </div>
      </div>
    </div>
  </div>


  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>


  <div class="container mt-5 mb-5">
    <div class="row justify-content-center">
      <div class="col-10">


        <div class="home-demo">

          <div class="owl-carousel owl-theme">
            <div class="item">
              <img src="assets/images/even.png" width="100px" height="195px" alt="">
            </div>
            <div class="item">
              <img src="assets/images/six.png" width="100px" height="195px" alt="">
            </div>
            <div class="item">
              <img src="assets/images/seven.png" width="100px" height="195px" alt="">
            </div>
          </div>
        </div>
      </div>
    </div>



    <script>
      $(function () {
        // Owl Carousel
        var owl = $(".owl-carousel");
        owl.owlCarousel({
          items: 2,
          margin: 70,

          loop: true,

        });
        $(".owl-dot").hide()
      });

    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN"
      crossorigin="anonymous"></script>
</body>

</html>