    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN" crossorigin="anonymous"></script>
    <script>
      var baseUrl = '<%= baseUrl %>'
      $(document).on('keyup', '#username', function(e) {
        e.preventDefault();
        var val = $(this).val();
        console.log("user",val)
        $.ajax({
          url: `${baseUrl}checktg`,
          type: "POST",
          dataType: "json",
          data: {
            'tgname': val
          },
          statusCode: {
            200: function(xhr) {
              if (xhr.data != null) {
                $('.atg').removeClass('d-none');
              } else {
                console.log("hello");
                $('.atg').addClass('d-none');
              }
            }
          }
        });
      });

      function eventHandler(e) {
        const {
          id,
          name,
          value
        } = e
        if (value.length > 0) {
          $(`.${id}`).text("");
        }
      }
      $(document).on('keyup', '#tgid', function(e) {
        
        var val = $(this).val();
        const regex = /^[a-zA-Z0-9_]*$/;
        const found = val.match(regex);
        if(found == null) {
          $(`.tgiderr`).html("Please Use(a-z,A-Z,0-9,_) this Characters")
        } else{
          $(`.tgiderr`).html("")
        }
       });
    </script>
    <script>
      $.getJSON("http://ipinfo.io/163.53.179.124?token=86245e8218f941", function (response) {

        $.ajax({
          url: `${baseUrl}country`,
          type: "POST",
          dataType: "json",
          data: {
            'country': response.country
          },
          statusCode: {
            200: function (xhr) {
              console.log(xhr.data[0].country_name);
              $('#country').val(xhr.data[0].country_name);
              $('#countryCode').val(response.country);
            }
          }
        });
      }, "jsonp");

    
      let isTost = '<%= session.isTost %>'
      let msg = '<%= session.tostMsg %>'
      let tostBackground = '<%= session.tostBackground %>'
      if (isTost == "true") {
        Toastify({
          text: msg,
          duration: 3000,
          newWindow: true,
          close: true,
          gravity: "top", // `top` or `bottom`
          position: "right", // `left`, `center` or `right`
          stopOnFocus: true, // Prevents dismissing of toast on hover
          style: {
            background: tostBackground,
          },
        }).showToast();
        '<%= session.isTost = "false"%>'
      }
    </script>
   
