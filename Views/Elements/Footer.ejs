	<!-- Login telegram account -->

	<div class="modal login-modal fade" id="loginModal" tabindex="-1" role="dialog" aria-labelledby="loginModalLabel"
		aria-hidden="true">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<form onsubmit="return false;" method="get" id="login-form" class="mb-0">
					<div class="modal-header bg-theme1 text-white text-center d-block">
						<h5 class="modal-title" id="loginModalLabel">Login</h5>
						<button type="button" class="close" data-dismiss="modal" aria-label="Close">
							<span aria-hidden="true">×</span>
						</button>
					</div>
					<div class="modal-body">
						<div class="input-group mb-1">
							<div class="input-group-prepend">
								<label class="mb-0"> <span class="text-danger ml-1"><sup>*</sup></span>User id </label>
							</div>
							<input type="text" class="form-control" name="ju_telegram" id="ju_telegram"
								placeholder="Enter Your Telegram Username" value="" autofocus="">
						</div>
						<div for="ju_telegram" class="input-notification error mb-1" id="login-error-msg"></div>

						<div class="input-group mb-1">
							<div class="input-group-prepend">
								<label class="mb-0"> <span class="text-danger ml-1"><sup>*</sup></span>Password </label>
							</div>
							<input type="password" class="form-control" name="password" id="password"
								placeholder="Enter Your Password" value="">
						</div>
						<div for="password" class="input-notification error mb-1" id="login-error"></div>
						<div for="login_not_match" class="input-notification error mb-1" id="login-error"></div>
						<div class="input-notification success ml-5 ml-sm-5" id="Error_login"></div>

						<div class="form-group text-right mb-0">
							<a href="#forgotModal" onclick="closeAllPopup();" data-toggle="modal"
								class="text-right forgot_password">Forgot Password ?</a>
						</div>
					</div>
					<div class="modal-footer bg-theme1">
						<button type="submit" class="btn btn-primary" title="Login" name="sign_in" id="login">
							<p class="mb-0 text">Submit</p>
							<span id="signup_loading_img" class="d-none">
								<img class="login_priloaded" src="<%= baseUrl %>assets/images/preloader-white.gif"
									alt="loader">
							</span>
						</button>
						<button type="button" class="btn btn-danger close-model" data-dismiss="modal">Cancel</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- END Login telegram account -->

	<!-- Forgot telegram account -->

	<div class="modal login-modal fade" id="forgotModal" tabindex="-1" role="dialog" aria-labelledby="forgotModalLabel">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<form action="#" method="post" id="forgot" onclick="return false;" class="mb-0">
					<div class="modal-header bg-theme1 text-white text-center d-block">
						<h5 class="modal-title" id="forgotModalLabel">Forgot Password ?</h5>
						<button type="button" class="close" data-dismiss="modal" aria-label="Close">
							<span aria-hidden="true">×</span>
						</button>
					</div>
					<div class="modal-body">
						<div class="input-group">
							<div class="input-group-prepend">
								<label class="col-form-label"><span class="text-danger ml-1"><sup>*</sup></span>
									Telegram ID</label>
							</div>
							<input type="email" class="form-control" name="id" id="id" placeholder="Username" value="">
						</div>
						<div for="forgot_not_match" class="input-notification error forgot_not_match ml-5 ml-sm-5">
						</div>
						<div for="success" id="success" class="input-notification text-success success ml-5 ml-sm-5">
						</div>
						<div for="id" class="input-notification error ml-5 ml-sm-5"></div>
					</div>
					<div class="modal-footer bg-theme1">
						<input class="btn btn-primary" type="submit" value="Submit" id="forgot_password"
							name="forgot_password">
						<button type="button" class="btn btn-danger close-model" data-dismiss="modal">Cancel</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- End Forgot telegram account -->

	<!-- Company Profile -->

	<div class="modal fade profile-modal" id="profileModal" tabindex="-1" role="dialog"
		aria-labelledby="profileModalLabel" aria-hidden="true">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<form class="mb-0">
					<div class="modal-header text-center bg-theme1 text-white">
						<h5 class="modal-title w-100" id="profileModalLabel">Select Profile</h5>
						<button type="button" class="close" data-dismiss="modal" aria-label="Close">
							<span aria-hidden="true">×</span>
						</button>
					</div>
					<div class="modal-body">

						<div class="form-group text-center mb-0">
							<div class="pro-radio mb-0">
								<input type="radio" class="d-none" name="profile" id="personal" value="1"
									checked="checked">
								<label for="personal" class="mb-0">Personal Profile</label>
							</div>
							<div class="pro-radio mb-0">
								<input type="radio" class="d-none" name="profile" id="company" value="2">
								<label for="company" class="mb-0">Company Profile</label>
							</div>
						</div>
						<div class="clearfix"></div>

					</div>
					<div class="modal-footer bg-theme1 justify-content-center">
						<button type="button" id="visit_link" class="btn btn-primary w-25">Visit</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- End Company Profile -->

	<!-- Scan QR Code -->

	<div class="modal fade scan-qr-modal" id="scanQRModal" tabindex="-1" role="dialog"
		aria-labelledby="scanQRModalLabel" aria-hidden="true">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<form class="mb-0">
					<div class="modal-header text-center bg-theme1 text-white">
						<h5 class="modal-title w-100" id="profileModalLabel">Touch to QR</h5>
						<button type="button" class="close" data-dismiss="modal" aria-label="Close">
							<span aria-hidden="true">×</span>
						</button>
					</div>
					<div class="modal-body">

						<div class="form-group text-center mb-0">
							<div class="pro-radio mb-0">
								<!-- <input type=text size=16 placeholder="Tracking Code" class=qrcode-text> -->
								<label class="qrcode-text-btn">
									<input type="file" accept="image/*" capture="environment"
										onclick="return showQRIntro();" onchange="openQRCamera(this);" tabindex="-1">
								</label>
							</div>
						</div>
					</div>
					<div class="modal-footer bg-theme1 justify-content-center d-none">
						<button type="button" id="visit_link" class="btn btn-primary w-25">Visit</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- Setting Page contact , theme, language in pop up -->

	<div class="modal fade setting-modal" id="settingModal" tabindex="-1" role="dialog"
		aria-labelledby="settingModalLabel" aria-hidden="true">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<form class="mb-0">
					<div class="modal-header text-center bg-theme1 text-white">
						<h5 class="modal-title w-100" id="profileModalLabel">Setting</h5>
						<button type="button" class="close" data-dismiss="modal" aria-label="Close">
							<span aria-hidden="true">×</span>
						</button>
					</div>
					<div class="modal-body">

						<div class="row justify-content-center">
							<div class="col-lg-6 col-md-8 col-12">

								<div class="setting-btn">
									<a href="<%= baseUrl %>assets/theme"
										class="btn btn-theme1 w-100 mb-3 button-color "><span class="font-color">Select
											your theme</span></a>
									<a class="btn btn-theme1 w-100 button-color cursor-no-drop"><span
											class="font-color">Contact List</span></a>
									<!-- <a href="#" class="btn btn-theme1 w-100 mt-3">Join us by Telegram</a> -->
									<div class="social-icon mt-3" style="cursor: pointer; color: #fff;">
										<div class="dropdown lan-dropdown ">
											<a class="btn btn-theme1 w-100 button-color" id="navbarDropdown"
												data-toggle="dropdown"><span class="font-color"> Adjust languages
												</span></a>
											<div class="dropdown-menu" aria-labelledby="navbarDropdown">
												<a class="dropdown-item" onclick="changeLanguage('ch');"><span
														class="">中</span></a>
												<a class="dropdown-item" onclick="changeLanguage('en');"><span
														class="">Eng</span></a>
											</div>
										</div>
									</div>

									<a href="#scanQRModal" data-toggle="modal"
										class="btn btn-theme1 w-100 mt-3 d-none scanQRModalBtn button-color"
										style="cursor: pointer; color: #fff;"><span class="font-color">Scan QR Code<span
												class="font-color"></span></span></a>
									<a onclick="checkIsMobileDevice();"
										class="d-none btn btn-theme1 w-100 mt-3 button-color"
										style="cursor: pointer; color: #fff;"><span class="font-color">Scan QR
											Code</span></a>
									<a href="" target="_blank"
										class="btn btn-theme1 w-100 mt-3 d-none button-color "><span
											class="font-color">Get QR Code</span></a>

								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer bg-theme1 justify-content-center d-none">
						<button type="button" id="visit_link" class="btn btn-primary w-25">Visit</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- End Scan QR Code -->

	<!-- Send link to telegram channel-->

	<div class="modal telegram-channel-modal fade" id="telegramChannelModal" tabindex="-1" role="dialog"
		aria-labelledby="telegramChannelModalLabel">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<form action="#" method="post" id="telegramChannel" onclick="return false;" class="mb-0">
					<div class="modal-header bg-theme1 text-white text-center d-block">
						<h5 class="modal-title" id="telegramChannelLabel">Join Channel Now</h5>
						<button type="button" class="close" data-dismiss="modal" aria-label="Close">
							<span aria-hidden="true">×</span>
						</button>
					</div>
					<div class="modal-body">
						<div class="input-group">
							<div class="input-group-prepend">
								<label class="col-form-label"><span class="text-danger"></span> Join our telegram
									channel to complete registration process and enjoy the stunning features of
									Mynamecard Services.</label>
							</div>
							<div class="input-notification success"></div>
						</div>
					</div>
					<div class="modal-footer bg-theme1 justify-content-center">
						<input class="btn btn-primary" type="submit" value="Yes" id="telegram_channel"
							name="telegram_channel">
						<button type="button" class="btn btn-danger close-model" data-dismiss="modal">No</button>
					</div>
				</form>
			</div>
		</div>
	</div>
	<!-- phon model-->

	<button type="button" class="btn btn-info btn-lg d-none phoneModal" data-toggle="modal"
		data-target="#phoneModal"></button>
	<div id="phoneModal" class="modal fade" role="dialog">
		<div class="modal-dialog text-center">
			<!-- Modal content-->
			<div class="modal-content" style="width: 60%; margin: 0 auto;">
				<div class="modal-header bg-theme1 text-white text-center">
					<h5 class="modal-title w-100" id="telegramModalLabel">Contact No</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">×</span>
					</button>
				</div>
				<div class="modal-body">
					<!-- Call Me @  --><span id="phone"></span>
				</div>
			</div>

		</div>
