	<div id="faxModal" class="modal fade" role="dialog">
		<div class="modal-dialog text-center">
			<!-- Modal content-->
			<div class="modal-content" style="width: 60%; margin: 0 auto;">
				<div class="modal-header bg-theme1 text-white text-center">
					<h5 class="modal-title w-100" id="telegramModalLabel">Fax</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">×</span>
					</button>
				</div>
				<div class="modal-body">
					Fax Us @ <span id="fax"></span>
				</div>
			</div>

		</div>
	</div>

	<!-- End Forgot telegram account -->

