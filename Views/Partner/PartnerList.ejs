<%- include('../Layout/Header') %>
<link
  rel="stylesheet"
  href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css"
/>
<%- include('../Layout/Sidebar') %>
<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3>
            <a href="<%= baseUrl %>admin/dashboard" class="text-primary"
              ><i class="fas fa-arrow-left me-2"></i></a
            >Partner Management
          </h3>
        </div>
        <div
          class="col-12 col-md-6 order-md-2 order-first d-flex justify-content-end align-items-center"
        >
          <nav
            aria-label="breadcrumb"
            class="breadcrumb-header float-start float-lg-end me-4 mb-0"
          >
            <ol class="breadcrumb" style="margin-bottom: 0px">
              <li class="breadcrumb-item">
                <a href="<%= baseUrl %>admin/dashboard">Dashboard</a>
              </li>
            </ol>
          </nav>
        </div>
      </div>
    </div>
    <section class="section">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-striped mb-0" id="partner_table">
            <thead>
              <tr>
                <th>No.</th>
                <th>tgUsername</th>
                <th>Country</th>
                <th>Referral Code</th>
                <th>User Credits</th>
                <th>Renewal Credits</th>
                <th>User Joined</th>
                <th>Status</th>
                <th>Joined Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% var i=1; partners.forEach(function(v) { %>
              <tr data-id="<%= v._id%>">
                <td><span class="name-field"><%= i %></span></td>
                <td>
                  <span class="name-field">
                    <% if (v.username) { %>
                    <a href="https://t.me/<%= v.username %>" target="_blank"
                      ><%= v.username %></a
                    >
                    <% } else if (v.tgid) { %>
                    <a href="https://t.me/<%= v.tgid %>" target="_blank"
                      ><%= v.tgid %></a
                    >
                    <% } else { %> N/A <% } %>
                  </span>
                </td>
                <td>
                  <span class="name-field"
                    ><%= v.country ? v.country + (v.countryCode ? ' (' +
                    v.countryCode + ')' : '') : 'N/A' %></span
                  >
                </td>
                <td>
                  <span class="name-field"
                    ><strong><%= v.referralCode%></strong></span
                  >
                </td>
                <td>
                  <span class="badge bg-info"
                    ><%= v.userCredits - v.usedUserCredits %> / <%=
                    v.userCredits %></span
                  >
                </td>
                <td>
                  <span class="badge bg-success"
                    ><%= v.renewalCredits - v.usedRenewalCredits %> / <%=
                    v.renewalCredits %></span
                  >
                </td>
                <td>
                  <span class="badge bg-primary"><%= v.totalUsers || 0 %></span>
                </td>
                <td>
                  <% if (v.status == 1) { %>
                  <span class="badge bg-success">Active</span>
                  <% } else { %>
                  <span class="badge bg-danger">Inactive</span>
                  <% } %>
                </td>
                <td>
                  <span class="name-field"
                    ><%= moment(v.createdAt).format('DD-MM-YYYY') %></span
                  >
                </td>
                <td>
                  <a
                    href="<%= baseUrl %>admin/partner/view/<%= v._id %>"
                    class="btn btn-primary btn-sm"
                  >
                    <i class="bi bi-eye"></i>
                  </a>
                  <% if (v.status == 1) { %>
                  <button
                    class="btn btn-warning btn-sm deactivate-btn"
                    data-id="<%= v._id%>"
                  >
                    <i class="bi bi-pause-circle"></i>
                  </button>
                  <% } else { %>
                  <button
                    class="btn btn-success btn-sm activate-btn"
                    data-id="<%= v._id%>"
                  >
                    <i class="bi bi-check-circle"></i>
                  </button>
                  <% } %>
                  <button
                    class="btn btn-danger btn-sm delete-btn"
                    data-id="<%= v._id%>"
                  >
                    <i class="bi bi-trash"></i>
                  </button>
                </td>
              </tr>
              <% i++ %> <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  const baseUrl = "<%= baseUrl %>";

  $(document).ready(function () {
    $("#partner_table").DataTable({
      order: [[8, "desc"]], // Sort by join date descending (Joined Date column)
    });

    // Activate partner
    $(".activate-btn").on("click", function () {
      const id = $(this).data("id");
      Swal.fire({
        title: "Activate Partner?",
        text: "This partner will be able to use their referral link again.",
        icon: "question",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, activate!",
      }).then((result) => {
        if (result.isConfirmed) {
          $.ajax({
            url: `${baseUrl}admin/partner/activate?id=${id}`,
            method: "GET",
            success: function (response) {
              Swal.fire(
                "Activated!",
                "Partner has been activated.",
                "success"
              ).then(() => location.reload());
            },
            error: function (err) {
              Swal.fire("Error!", "Failed to activate partner.", "error");
            },
          });
        }
      });
    });

    // Deactivate partner
    $(".deactivate-btn").on("click", function () {
      const id = $(this).data("id");
      Swal.fire({
        title: "Deactivate Partner?",
        text: "This partner will not be able to use their referral link.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Yes, deactivate!",
      }).then((result) => {
        if (result.isConfirmed) {
          $.ajax({
            url: `${baseUrl}admin/partner/deactivate?id=${id}`,
            method: "GET",
            success: function (response) {
              Swal.fire(
                "Deactivated!",
                "Partner has been deactivated.",
                "success"
              ).then(() => location.reload());
            },
            error: function (err) {
              Swal.fire("Error!", "Failed to deactivate partner.", "error");
            },
          });
        }
      });
    });

    // Delete partner
    $(".delete-btn").on("click", function () {
      const id = $(this).data("id");
      Swal.fire({
        title: "Delete Partner?",
        text: "This action cannot be undone! All partner data will be removed.",
        icon: "error",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Yes, delete it!",
      }).then((result) => {
        if (result.isConfirmed) {
          $.ajax({
            url: `${baseUrl}admin/partner/delete?id=${id}`,
            method: "GET",
            success: function (response) {
              Swal.fire(
                "Deleted!",
                "Partner has been deleted.",
                "success"
              ).then(() => location.reload());
            },
            error: function (err) {
              Swal.fire("Error!", "Failed to delete partner.", "error");
            },
          });
        }
      });
    });
  });
</script>
<%- include('../Layout/Footer') %>
