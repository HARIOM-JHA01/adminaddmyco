<%- include('../Layout/Header') %>
<link
  rel="stylesheet"
  href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css"
/>
<%- include('../Layout/Sidebar') %>
<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3>
            <a href="<%= baseUrl %>admin/partner/list" class="text-primary"
              ><i class="fas fa-arrow-left me-2"></i></a
            >Partner Details
          </h3>
        </div>
        <div class="col-12 col-md-6 order-md-2 order-first">
          <nav
            aria-label="breadcrumb"
            class="breadcrumb-header float-start float-lg-end"
          >
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <a href="<%= baseUrl %>admin/dashboard">Dashboard</a>
              </li>
              <li class="breadcrumb-item">
                <a href="<%= baseUrl %>admin/partner/list">Partners</a>
              </li>
              <li class="breadcrumb-item active">Details</li>
            </ol>
          </nav>
        </div>
      </div>
    </div>

    <section class="section">
      <!-- Partner Info Card -->
      <div class="card">
        <div class="card-header">
          <h4 class="card-title">Partner Information</h4>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <table class="table table-borderless">
                <tr>
                  <th width="200">TGUsername:</th>
                  <td>
                    <% if (partner.username) { %>
                    <a
                      href="https://t.me/<%= partner.username %>"
                      target="_blank"
                      ><%= partner.username %></a
                    >
                    <% } else { %>
                    <span>N/A</span>
                    <% } %>
                  </td>
                </tr>
                <tr>
                  <th>Country:</th>
                  <td>
                    <%= partner.country ? partner.country : 'N/A' %> <% if
                    (partner.countryCode) { %> (<%= partner.countryCode %>) <% }
                    %>
                  </td>
                </tr>
                <tr>
                  <th>Status:</th>
                  <td>
                    <% if (partner.status == 1) { %>
                    <span class="badge bg-success">Active</span>
                    <% } else { %>
                    <span class="badge bg-danger">Inactive</span>
                    <% } %>
                  </td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <table class="table table-borderless">
                <tr>
                  <th>Referral Code:</th>
                  <td><strong><%= partner.referralCode%></strong></td>
                </tr>
                <tr>
                  <th>Partner Referral Link:</th>
                  <td>
                    <a
                      href="https://partner.addmy.co/t.me/ref-<%= partner.referralCode %>"
                      target="_blank"
                    >
                      https://partner.addmy.co/t.me/ref-<%= partner.referralCode
                      %>
                    </a>
                  </td>
                </tr>
                <!-- <tr>
                  <th>Referral URL:</th>
                  <td><code><%= partner.referralUrl%></code></td>
                </tr> -->
                <tr>
                  <th>Premium Credits:</th>
                  <td>
                    <span class="badge bg-info"
                      ><%= partner.userCredits - partner.usedUserCredits %>
                      available / <%= partner.userCredits %> total</span
                    >
                  </td>
                </tr>
                <tr>
                  <th>Renewal Credits:</th>
                  <td>
                    <span class="badge bg-success"
                      ><%= partner.renewalCredits - partner.usedRenewalCredits
                      %> available / <%= partner.renewalCredits %> total</span
                    >
                  </td>
                </tr>
                <tr>
                  <th>Joined Date:</th>
                  <td>
                    <%= moment(partner.createdAt).format('DD-MM-YYYY HH:mm') %>
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Statistics Cards -->
      <div class="row">
        <div class="col-md-3">
          <div class="card">
            <div class="card-body">
              <h6 class="text-muted">User Joined</h6>
              <h3><%= stats.totalUsers %></h3>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card">
            <div class="card-body">
              <h6 class="text-muted">Active Users</h6>
              <h3><%= stats.activeUsers %></h3>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card">
            <div class="card-body">
              <h6 class="text-muted">Total Renewals</h6>
              <h3><%= stats.totalRenewals %></h3>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card">
            <div class="card-body">
              <h6 class="text-muted">Total Payments</h6>
              <h3><%= stats.totalPayments %></h3>
            </div>
          </div>
        </div>
      </div>

      <!-- Partner Users Table -->
      <div class="card">
        <div class="card-header">
          <h4 class="card-title">Users Joined</h4>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped mb-0" id="users_table">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Username</th>
                  <th>Member ID</th>
                  <th>Country</th>
                  <th>Membership Expiry</th>
                  <th>Total Renewals</th>
                  <th>Status</th>
                  <th>Joined Date</th>
                </tr>
              </thead>
              <tbody>
                <% var i=1; partnerUsers.forEach(function(v) { %>
                <tr>
                  <td><%= i %></td>
                  <td><%= v.user.username %></td>
                  <td><%= v.user.memberid %></td>
                  <td>
                    <%= v.user.country ? v.user.country : 'N/A' %> <% if
                    (v.user.countryCode) { %> (<%= v.user.countryCode %>) <% }
                    %>
                  </td>
                  <td>
                    <%= moment(v.membershipExpiryDate).format('DD-MM-YYYY') %>
                  </td>
                  <td>
                    <span class="badge bg-primary"><%= v.renewalCount %></span>
                  </td>
                  <td>
                    <% if (moment(v.membershipExpiryDate).isAfter(moment())) {
                    %>
                    <span class="badge bg-success">Active</span>
                    <% } else { %>
                    <span class="badge bg-danger">Expired</span>
                    <% } %>
                  </td>
                  <td><%= moment(v.createdAt).format('DD-MM-YYYY') %></td>
                </tr>
                <% i++ %> <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Payment History Table -->
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h4 class="card-title mb-0">Payment History</h4>
          <button
            class="btn btn-primary btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#addCreditModal"
          >
            <i class="bi bi-plus-circle me-1"></i> Add Credit
          </button>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped mb-0" id="payments_table">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Package</th>
                  <th>Credit Type</th>
                  <th>Credits</th>
                  <th>Amount</th>
                  <th>Transaction ID</th>
                  <th>Status</th>
                  <th>Payment Date</th>
                  <th>Approved By</th>
                </tr>
              </thead>
              <tbody>
                <% payments.forEach(function(v) { %>
                <tr>
                  <td></td>
                  <td><%= v.package ? v.package.name : 'N/A' %></td>
                  <td>
                    <% if (v.packageType === 'USER_CREDITS') { %>
                    <span class="badge bg-info">Premium</span>
                    <% } else { %>
                    <span class="badge bg-success">Renewal</span>
                    <% } %>
                  </td>
                  <td><%= v.credits || 0 %></td>
                  <td>$<%= v.amount %></td>
                  <td><%= v.transactionId %></td>
                  <td>
                    <% if (v.status == 0) { %>
                    <span class="badge bg-warning">Pending</span>
                    <% } else if (v.status == 1) { %>
                    <span class="badge bg-success">Approved</span>
                    <% } else { %>
                    <span class="badge bg-danger">Rejected</span>
                    <% } %>
                  </td>
                  <td><%= moment(v.paymentDate || v.createdAt).format('DD-MM-YYYY HH:mm') %></td>
                  <td><%= v.approvedBy ? v.approvedBy.name : 'N/A' %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<!-- Add Credit Modal -->
<div class="modal fade" id="addCreditModal" tabindex="-1" aria-labelledby="addCreditModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addCreditModalLabel">Add Credit to Partner</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="addCreditForm">
          <div class="mb-3">
            <label class="form-label fw-semibold">Credit Type</label>
            <select class="form-select" id="creditPackageType" required>
              <option value="USER_CREDITS">Premium Credits (User Credits)</option>
              <option value="RENEWAL_CREDITS">Renewal Credits</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Number of Credits</label>
            <input type="number" class="form-control" id="creditAmount" min="1" placeholder="Enter credits" required />
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="submitAddCredit">Add Credits</button>
      </div>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  const baseUrl = "<%= baseUrl %>";
  const partnerId = "<%= partner._id %>";

  $(document).ready(function () {
    $("#users_table").DataTable({
      order: [[7, "desc"]],
    });
    $("#payments_table").DataTable({
      order: [[7, "desc"]],
      columnDefs: [
        {
          targets: 0,
          render: function (data, type, row, meta) {
            return meta.settings._iDisplayStart + meta.settings.aiDisplay.indexOf(meta.row) + 1;
          },
        },
      ],
    });

    $("#submitAddCredit").on("click", function () {
      const packageType = $("#creditPackageType").val();
      const credits = parseInt($("#creditAmount").val());

      if (!credits || credits <= 0) {
        Swal.fire("Error", "Please enter a valid number of credits.", "error");
        return;
      }

      const $btn = $(this);
      $btn.prop("disabled", true).text("Adding...");

      $.ajax({
        url: `${baseUrl}admin/partner/add-credit`,
        method: "POST",
        data: { partnerId, packageType, credits },
        success: function (response) {
          Swal.fire("Success", response.message, "success").then(() => {
            location.reload();
          });
        },
        error: function (xhr) {
          $btn.prop("disabled", false).text("Add Credits");
          Swal.fire("Error", xhr.responseJSON?.message || "Failed to add credits.", "error");
        },
      });
    });
  });
</script>
<%- include('../Layout/Footer') %>
