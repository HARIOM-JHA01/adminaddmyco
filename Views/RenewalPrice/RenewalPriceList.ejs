<%- include('../Layout/Header') %>
<link
  rel="stylesheet"
  href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css"
/>
<%- include('../Layout/Sidebar') %>
<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3>
            <a href="<%= baseUrl %>admin/dashboard" class="text-primary"
              ><i class="fas fa-arrow-left me-2"></i></a
            >Renewal Prices
          </h3>
        </div>
        <div
          class="col-12 col-md-6 order-md-2 order-first d-flex justify-content-end align-items-center"
        >
          <nav
            aria-label="breadcrumb"
            class="breadcrumb-header float-start float-lg-end me-4 mb-0"
          >
            <ol class="breadcrumb" style="margin-bottom: 0px">
              <li class="breadcrumb-item">
                <a href="<%= baseUrl %>admin/dashboard">Dashboard</a>
              </li>
            </ol>
          </nav>
          <button
            type="button"
            class="btn btn-primary btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#createModal"
          >
            <i class="bi bi-plus-circle"></i> Create Renewal Price
          </button>
        </div>
      </div>
    </div>
    <section class="section">
      <div class="card-body">
        <div class="alert alert-info">
          <i class="bi bi-info-circle"></i> These are the discounted renewal
          prices available to partners for renewing their users' memberships.
        </div>
        <div class="table-responsive">
          <table class="table table-striped mb-0" id="renewal_table">
            <thead>
              <tr>
                <th>No.</th>
                <th>Membership Period</th>
                <th>Original Price</th>
                <th>Partner Price</th>
                <th>Discount</th>
                <th>Savings</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% var i=1; renewalPrices.forEach(function(v) { %>
              <tr data-id="<%= v._id%>">
                <td><%= i %></td>
                <td>
                  <strong
                    ><%= v.membershipMonths %> <%= v.membershipMonths === 1 ?
                    'Month' : 'Months' %></strong
                  >
                </td>
                <td>$<%= v.originalPrice %></td>
                <td>
                  <strong class="text-success">$<%= v.partnerPrice %></strong>
                </td>
                <td>
                  <span class="badge bg-info"
                    ><%= v.discountPercentage.toFixed(2) %>%</span
                  >
                </td>
                <td>
                  <span class="badge bg-success"
                    >$<%= (v.originalPrice - v.partnerPrice).toFixed(2) %></span
                  >
                </td>
                <td>
                  <% if (v.status == 1) { %>
                  <span class="badge bg-success">Active</span>
                  <% } else { %>
                  <span class="badge bg-danger">Inactive</span>
                  <% } %>
                </td>
                <td>
                  <button
                    class="btn btn-primary btn-sm edit-btn"
                    data-id="<%= v._id%>"
                    data-months="<%= v.membershipMonths%>"
                    data-original="<%= v.originalPrice%>"
                    data-partner="<%= v.partnerPrice%>"
                    data-status="<%= v.status%>"
                  >
                    <i class="bi bi-pencil-square"></i>
                  </button>
                  <% if (v.status == 1) { %>
                  <button
                    class="btn btn-warning btn-sm deactivate-btn"
                    data-id="<%= v._id%>"
                  >
                    <i class="bi bi-pause-circle"></i>
                  </button>
                  <% } else { %>
                  <button
                    class="btn btn-success btn-sm activate-btn"
                    data-id="<%= v._id%>"
                  >
                    <i class="bi bi-check-circle"></i>
                  </button>
                  <% } %>
                  <button
                    class="btn btn-danger btn-sm delete-btn"
                    data-id="<%= v._id%>"
                  >
                    <i class="bi bi-trash"></i>
                  </button>
                </td>
              </tr>
              <% i++ %> <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Create Renewal Price</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <form id="createForm">
          <div class="form-group">
            <label for="create_months"
              >Membership Period <span class="text-danger">*</span></label
            >
            <select class="form-control" id="create_months" required>
              <option value="">Select Period</option>
              <option value="1">1 Month</option>
              <option value="3">3 Months</option>
              <option value="6">6 Months</option>
              <option value="12">12 Months (1 Year)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="create_original"
              >Original Price (USDT) <span class="text-danger">*</span></label
            >
            <input
              type="number"
              class="form-control"
              id="create_original"
              min="0"
              step="0.01"
              required
            />
          </div>
          <div class="form-group">
            <label for="create_partner"
              >Partner Price (USDT) <span class="text-danger">*</span></label
            >
            <input
              type="number"
              class="form-control"
              id="create_partner"
              min="0"
              step="0.01"
              required
            />
          </div>
          <div class="form-group">
            <label for="create_status">Status</label>
            <select class="form-control" id="create_status">
              <option value="1">Active</option>
              <option value="0">Inactive</option>
            </select>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button type="button" class="btn btn-primary" id="createBtn">
          Create
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Renewal Price</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <form id="editForm">
          <input type="hidden" id="edit_id" />
          <div class="form-group">
            <label for="edit_months"
              >Membership Period <span class="text-danger">*</span></label
            >
            <select class="form-control" id="edit_months" required>
              <option value="1">1 Month</option>
              <option value="3">3 Months</option>
              <option value="6">6 Months</option>
              <option value="12">12 Months (1 Year)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="edit_original"
              >Original Price (USDT) <span class="text-danger">*</span></label
            >
            <input
              type="number"
              class="form-control"
              id="edit_original"
              min="0"
              step="0.01"
              required
            />
          </div>
          <div class="form-group">
            <label for="edit_partner"
              >Partner Price (USD) <span class="text-danger">*</span></label
            >
            <input
              type="number"
              class="form-control"
              id="edit_partner"
              min="0"
              step="0.01"
              required
            />
          </div>
          <div class="form-group">
            <label for="edit_status">Status</label>
            <select class="form-control" id="edit_status">
              <option value="1">Active</option>
              <option value="0">Inactive</option>
            </select>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button type="button" class="btn btn-primary" id="updateBtn">
          Update
        </button>
      </div>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  const baseUrl = "<%= baseUrl %>";

  $(document).ready(function () {
    $("#renewal_table").DataTable();

    // Create renewal price
    $("#createBtn").on("click", function () {
      const formData = {
        membershipMonths: parseInt($("#create_months").val()),
        originalPrice: parseFloat($("#create_original").val()),
        partnerPrice: parseFloat($("#create_partner").val()),
        status: parseInt($("#create_status").val()),
      };

      if (
        !formData.membershipMonths ||
        !formData.originalPrice ||
        !formData.partnerPrice
      ) {
        Swal.fire("Error!", "Please fill all required fields.", "error");
        return;
      }

      if (formData.partnerPrice >= formData.originalPrice) {
        Swal.fire(
          "Error!",
          "Partner price must be less than original price.",
          "error"
        );
        return;
      }

      $.ajax({
        url: `${baseUrl}admin/renewal-price/create`,
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify(formData),
        success: function (response) {
          Swal.fire(
            "Success!",
            "Renewal price created successfully.",
            "success"
          ).then(() => location.reload());
        },
        error: function (err) {
          Swal.fire(
            "Error!",
            err.responseJSON?.message || "Failed to create renewal price.",
            "error"
          );
        },
      });
    });

    // Open edit modal
    $(".edit-btn").on("click", function () {
      $("#edit_id").val($(this).data("id"));
      $("#edit_months").val($(this).data("months"));
      $("#edit_original").val($(this).data("original"));
      $("#edit_partner").val($(this).data("partner"));
      $("#edit_status").val($(this).data("status"));
      $("#editModal").modal("show");
    });

    // Update renewal price
    $("#updateBtn").on("click", function () {
      const id = $("#edit_id").val();
      const formData = {
        membershipMonths: parseInt($("#edit_months").val()),
        originalPrice: parseFloat($("#edit_original").val()),
        partnerPrice: parseFloat($("#edit_partner").val()),
        status: parseInt($("#edit_status").val()),
      };

      if (formData.partnerPrice >= formData.originalPrice) {
        Swal.fire(
          "Error!",
          "Partner price must be less than original price.",
          "error"
        );
        return;
      }

      $.ajax({
        url: `${baseUrl}admin/renewal-price/edit/${id}`,
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify(formData),
        success: function (response) {
          Swal.fire(
            "Success!",
            "Renewal price updated successfully.",
            "success"
          ).then(() => location.reload());
        },
        error: function (err) {
          Swal.fire(
            "Error!",
            err.responseJSON?.message || "Failed to update renewal price.",
            "error"
          );
        },
      });
    });

    // Activate
    $(".activate-btn").on("click", function () {
      const id = $(this).data("id");
      $.ajax({
        url: `${baseUrl}admin/renewal-price/activate?id=${id}`,
        method: "GET",
        success: function (response) {
          Swal.fire(
            "Activated!",
            "Renewal price has been activated.",
            "success"
          ).then(() => location.reload());
        },
        error: function (err) {
          Swal.fire("Error!", "Failed to activate.", "error");
        },
      });
    });

    // Deactivate
    $(".deactivate-btn").on("click", function () {
      const id = $(this).data("id");
      $.ajax({
        url: `${baseUrl}admin/renewal-price/deactivate?id=${id}`,
        method: "GET",
        success: function (response) {
          Swal.fire(
            "Deactivated!",
            "Renewal price has been deactivated.",
            "success"
          ).then(() => location.reload());
        },
        error: function (err) {
          Swal.fire("Error!", "Failed to deactivate.", "error");
        },
      });
    });

    // Delete
    $(".delete-btn").on("click", function () {
      const id = $(this).data("id");
      Swal.fire({
        title: "Delete Renewal Price?",
        text: "This action cannot be undone!",
        icon: "error",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Yes, delete it!",
      }).then((result) => {
        if (result.isConfirmed) {
          $.ajax({
            url: `${baseUrl}admin/renewal-price/delete?id=${id}`,
            method: "GET",
            success: function (response) {
              Swal.fire(
                "Deleted!",
                "Renewal price has been deleted.",
                "success"
              ).then(() => location.reload());
            },
            error: function (err) {
              Swal.fire("Error!", "Failed to delete.", "error");
            },
          });
        }
      });
    });
  });
</script>
<%- include('../Layout/Footer') %>
