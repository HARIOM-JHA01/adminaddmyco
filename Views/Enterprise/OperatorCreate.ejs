<%- include('../Layout/Header') %>
<%- include('../Layout/Sidebar') %>

<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3><a href="<%= baseUrl %>admin/enterprise/operators" class="text-primary"><i class="fas fa-arrow-left me-2"></i></a>Create Operator</h3>
        </div>
      </div>
    </div>

    <section class="section">
      <div class="card">
        <div class="card-body">
          <form id="createOperatorForm">
            <div class="form-group mb-3">
              <label for="name" class="form-label">Operator Name *</label>
              <input type="text" class="form-control" id="name" name="name" required>
            </div>

            <div class="form-group mb-3">
              <label for="email" class="form-label">Email *</label>
              <input type="email" class="form-control" id="email" name="email" required>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label for="password" class="form-label">Password *</label>
                  <input type="password" class="form-control" id="password" name="password" required minlength="8">
                  <small class="form-text text-muted">Minimum 8 characters</small>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label for="confirmPassword" class="form-label">Confirm Password *</label>
                  <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required minlength="8">
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label for="initialCredits" class="form-label">Initial Employee Credits (optional)</label>
                  <input type="number" class="form-control" id="initialCredits" name="initialCredits" min="0">
                </div>
              </div>

            </div>

            <div class="form-group mb-3">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="isActive" name="isActive" value="true" checked>
                <label class="form-check-label" for="isActive">
                  Active
                </label>
              </div>
            </div>

            <div class="form-group">
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> Create Operator
              </button>
              <a href="<%= baseUrl %>admin/enterprise/operators" class="btn btn-secondary">Cancel</a>
            </div>

            <div id="errorAlert" class="alert alert-danger mt-3" style="display:none;"></div>
            <div id="successAlert" class="alert alert-success mt-3" style="display:none;"></div>
          </form>
        </div>
      </div>
    </section>
  </div>
</div>

<footer>
  <div class="footer clearfix mb-0 text-muted">
    <div class="float-start">
      <p>2023 &copy; All rights are reserved</p>
    </div>
  </div>
</footer>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
$(document).on('submit', '#createOperatorForm', function(e) {
  e.preventDefault();
  
  var baseUrl = '<%= baseUrl %>';
  var formData = {
    name: $('#name').val(),
    email: $('#email').val(),
    password: $('#password').val(),
    confirmPassword: $('#confirmPassword').val(),
    isActive: $('#isActive').is(':checked'),
    initialCredits: parseInt($('#initialCredits').val() || 0, 10) 
  };

  $.ajax({
    type: "POST",
    url: baseUrl + 'admin/enterprise/operator/create',
    data: JSON.stringify(formData),
    contentType: 'application/json',
    dataType: "json",
    success: function(response) {
      if (response.success) {
        $('#successAlert').text(response.message).show();
        setTimeout(() => {
          window.location.href = baseUrl + 'admin/enterprise/operators';
        }, 1500);
      }
    },
    error: function(err) {
      var message = err.responseJSON?.message || 'Error creating operator';
      $('#errorAlert').text(message).show();
    }
  });
});
</script>
