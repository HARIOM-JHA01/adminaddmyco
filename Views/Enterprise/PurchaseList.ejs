<%- include('../Layout/Header') %>
<link rel="stylesheet" href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css">
<%- include('../Layout/Sidebar') %>

<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3><a href="<%= baseUrl %>admin/dashboard" class="text-primary"><i class="fas fa-arrow-left me-2"></i></a>Enterprise Purchases</h3>
        </div>
      </div>
    </div>

    <section class="section">
      <div class="card">
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped" id="purchaseTable">
              <thead>
                <tr>
                  <th>Package Name</th>
                  <th>Amount (USDT)</th>
                  <th>Transaction ID</th>
                  <th>Wallet Address</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (purchases && purchases.length > 0) { %>
                  <% purchases.forEach(purchase => { %>
                  <tr>
                    <td><%= purchase.package ? purchase.package.name : 'N/A' %></td>
                    <td><strong>$<%= purchase.amount %></strong></td>
                    <td><code><%= purchase.transactionId || 'N/A' %></code></td>
                    <td><code><%= purchase.walletAddress || 'N/A' %></code></td>
                    <td>
                      <% if (purchase.status === 0) { %>
                        <span class="badge bg-warning">Pending</span>
                      <% } else if (purchase.status === 1) { %>
                        <span class="badge bg-success">Approved</span>
                      <% } else if (purchase.status === 2) { %>
                        <span class="badge bg-danger">Rejected</span>
                      <% } else { %>
                        <span class="badge bg-secondary">Cancelled</span>
                      <% } %>
                    </td>
                    <td><%= moment(purchase.createdAt).format('DD-MM-YYYY') %></td>
                    <td>
                      <% if (purchase.status === 0) { %>
                        <button class="btn btn-sm btn-success approve-purchase" data-id="<%= purchase._id %>">Approve</button>
                        <button class="btn btn-sm btn-danger reject-purchase" data-id="<%= purchase._id %>">Reject</button>
                      <% } else { %>
                        <span class="text-muted text-sm">-</span>
                      <% } %>
                    </td>
                  </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center text-muted">No purchases found</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<footer>
  <div class="footer clearfix mb-0 text-muted">
    <div class="float-start">
      <p>2023 &copy; All rights are reserved</p>
    </div>
  </div>
</footer>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
$(document).ready(function() {
  $('#purchaseTable').DataTable({
    "searching": true,
    "paging": true
  });
});

$(document).on('click', '.approve-purchase', function() {
  var purchaseId = $(this).data('id');
  var baseUrl = '<%= baseUrl %>';
  
  Swal.fire({
    title: "Approve Purchase?",
    text: "Credits will be granted to the user account",
    icon: "question",
    showCancelButton: true,
    confirmButtonColor: "#28a745",
    cancelButtonColor: "#6c757d",
    confirmButtonText: "Yes, approve!",
  }).then((result) => {
    if (result.isConfirmed) {
      $.ajax({
        type: "POST",
        url: baseUrl + 'admin/enterprise/purchase/approve/' + purchaseId,
        dataType: "json",
        success: function(response) {
          if (response.success) {
            Swal.fire(
              "Approved!",
              response.message,
              "success"
            ).then(() => location.reload());
          } else {
            Swal.fire(
              "Error!",
              response.message || 'Error approving purchase',
              "error"
            );
          }
        },
        error: function(err) {
          Swal.fire(
            "Error!",
            err.responseJSON?.message || 'Error approving purchase',
            "error"
          );
        }
      });
    }
  });
});

$(document).on('click', '.reject-purchase', function() {
  var purchaseId = $(this).data('id');
  var baseUrl = '<%= baseUrl %>';
  
  Swal.fire({
    title: "Reject Purchase?",
    text: "User will be notified of rejection",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#dc3545",
    cancelButtonColor: "#6c757d",
    confirmButtonText: "Yes, reject!",
    input: "textarea",
    inputPlaceholder: "Rejection reason (required)",
    inputAttributes: {
      "aria-label": "Rejection reason",
    },
    inputValidator: (value) => {
      if (!value) {
        return "Please provide a rejection reason";
      }
    },
  }).then((result) => {
    if (result.isConfirmed) {
      $.ajax({
        type: "POST",
        url: baseUrl + 'admin/enterprise/purchase/reject/' + purchaseId,
        data: JSON.stringify({ rejectionReason: result.value }),
        contentType: "application/json",
        dataType: "json",
        success: function(response) {
          if (response.success) {
            Swal.fire(
              "Rejected!",
              response.message,
              "success"
            ).then(() => location.reload());
          } else {
            Swal.fire(
              "Error!",
              response.message || 'Error rejecting purchase',
              "error"
            );
          }
        },
        error: function(err) {
          Swal.fire(
            "Error!",
            err.responseJSON?.message || 'Error rejecting purchase',
            "error"
          );
        }
      });
    }
  });
});
</script>
