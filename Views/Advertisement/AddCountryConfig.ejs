<%- include('../Layout/Header') %> <%- include('../Layout/Sidebar') %>
<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3>Add Country Advertisement Config</h3>
        </div>
      </div>
    </div>

    <section class="section">
      <div class="card">
        <div class="card-body">
          <% if (message) { %>
          <div class="alert alert-danger"><%= message %></div>
          <% } %>
          <form
            method="post"
            action="<%= baseUrl %>admin/advertisements/country-config/create"
          >
            <div class="mb-3">
              <label class="form-label">Country Code (ISO)</label>
              <input
                type="text"
                name="countryCode"
                class="form-control"
                value="<%= data.countryCode || '' %>"
                placeholder="US, IN, GLOBAL"
              />
            </div>
            <div class="mb-3">
              <label class="form-label">Country Name (optional)</label>
              <input
                type="text"
                name="countryName"
                class="form-control"
                value="<%= data.countryName || '' %>"
              />
            </div>
            <div class="mb-3 form-check">
              <input type="checkbox" name="enabled" class="form-check-input"
              id="enabled" <% if (data.enabled === 'on' || data.enabled ===
              true) { %>checked<% } %> >
              <label class="form-check-label" for="enabled">Enabled</label>
            </div>
            <button class="btn btn-primary">Create</button>
            <a
              class="btn btn-secondary"
              href="<%= baseUrl %>admin/advertisements/country-config"
              >Cancel</a
            >
          </form>
        </div>
      </div>
    </section>
  </div>
</div>
<%- include('../Layout/Footer') %>
