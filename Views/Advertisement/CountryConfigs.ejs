<%- include('../Layout/Header') %>
<%- include('../Layout/Sidebar') %>
<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3><a href="<%= baseUrl %>admin/advertisements/manage" class="text-primary"><i class="fas fa-arrow-left me-2"></i>Advertisement Country Configurations</h3>
        </div>
        <div class="col-12 col-md-6 order-md-2 order-first">
          <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="<%= baseUrl %>admin/dashboard">Dashboard</a></li>
              <li class="breadcrumb-item active" aria-current="page">Ad Country Configs</li>
            </ol>
          </nav>
        </div>
      </div>
    </div>

    <section class="section">
      <div class="card">
        <div class="card-header text-end">
          <a href="<%= baseUrl %>admin/advertisements/country-config/create" class="btn btn-primary btn-sm">Add Country Config</a>
        </div>
        <div class="dataTable-container">
          <table class="table table-striped dataTable-table" id="table1">
            <thead>
              <tr>
                <th>No.</th>
                <th>Country Code</th>
                <th>Country Name</th>
                <th>Enabled</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% var i=1; configs.forEach(function(v) { %>
              <tr data-id="<%= v._id%>">
                <td><%= i %></td>
                <td><%= v.countryCode %></td>
                <td><%= v.countryName || '-' %></td>
                <td><%= v.enabled ? 'Yes' : 'No' %></td>
                <td>
                  <a href="<%= baseUrl %>admin/advertisements/country-config/edit?id=<%= v._id %>" class="btn btn-primary btn-sm">Edit</a>
                  <button type="button" data-id="<%= v._id %>" class="btn btn-danger btn-sm delete-config">Delete</button>
                </td>
              </tr>
              <% i++; }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).on('click', '.delete-config', function() {
  var id = $(this).data('id');
  var baseUrl = '<%= baseUrl %>';
  if (confirm('Delete this configuration?')) {
    $.get(`${baseUrl}admin/advertisements/country-config/delete?id=${id}`, function(xhr) {
      if (xhr.status) {
        $(`tr[data-id="${id}"]`).remove();
        alert('Deleted');
      }
    });
  }
});
</script>

<%- include('../Layout/Footer') %>