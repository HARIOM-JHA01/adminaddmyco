<%- include('../Layout/Header') %>
<%- include('../Layout/Sidebar') %>
<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3><a href="<%= baseUrl %>admin/package/list" class="text-primary"><i class="fas fa-arrow-left me-2"></i></a>Edit Package</h3>
        </div>
        <div class="col-12 col-md-6 order-md-2 order-first">
          <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="<%= baseUrl %>admin/dashboard">Dashboard</a></li>
              <li class="breadcrumb-item"><a href="<%= baseUrl %>admin/package/list">Packages</a></li>
              <li class="breadcrumb-item active">Edit</li>
            </ol>
          </nav>
        </div>
      </div>
    </div>

    <section class="section">
      <div class="card">
        <div class="card-header">
          <h4 class="card-title">Package Details</h4>
        </div>
        <div class="card-body">
          <form id="packageForm">
            <input type="hidden" id="packageId" value="<%= package._id %>">
            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                  <label for="type">Package Type <span class="text-danger">*</span></label>
                  <select class="form-control" id="type" name="type" required>
                    <option value="">Select Type</option>
                    <option value="USER_CREDITS" <%= package.type === 'USER_CREDITS' ? 'selected' : '' %>>Premium Credits</option>
                    <option value="RENEWAL_CREDITS" <%= package.type === 'RENEWAL_CREDITS' ? 'selected' : '' %>>Renewal Credits</option>
                  </select>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                  <label for="name">Package Name <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="name" name="name" value="<%= package.name %>" required>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                  <label for="credits">Credits <span class="text-danger">*</span></label>
                  <input type="number" class="form-control" id="credits" name="credits" min="1" value="<%= package.credits %>" required>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                  <label for="price">Price (USD) <span class="text-danger">*</span></label>
                  <input type="number" class="form-control" id="price" name="price" min="0" step="0.01" value="<%= package.price %>" required>
                </div>
              </div>
              <!-- discount removed per requirements -->
            </div>

            <!-- RenewalYears removed per request; default set to 1 in model -->

            <!-- Description removed per requirements -->

            <div class="row">
              <div class="col-md-12">
                <div class="form-group">
                  <label for="status">Status</label>
                  <select class="form-control" id="status" name="status">
                    <option value="1" <%= package.status === 1 ? 'selected' : '' %>>Active</option>
                    <option value="0" <%= package.status === 0 ? 'selected' : '' %>>Inactive</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="row mt-3">
              <div class="col-md-12">
                <button type="submit" class="btn btn-primary">Update Package</button>
                <a href="<%= baseUrl %>admin/package/list" class="btn btn-secondary">Cancel</a>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  const baseUrl = "<%= baseUrl %>";

  // Show/hide renewal months based on type
  // renewalYears removed from UI; server defaults to 1 year

  // Handle form submission
  $('#packageForm').on('submit', function(e) {
    e.preventDefault();
    
    const packageId = $('#packageId').val();
    const formData = {
      name: $('#name').val(),
      type: $('#type').val(),
      credits: parseInt($('#credits').val()),
      price: parseFloat($('#price').val()),
      // discount and description removed
      status: parseInt($('#status').val())
    };

    // include id in body to support both /package/edit (body id) and /package/edit/:id
    formData.id = packageId;

    // renewalYears is defaulted to 1 by the server; no client input

    $.ajax({
      url: `${baseUrl}admin/package/edit/${packageId}`,
      method: 'POST',
      contentType: 'application/json',
      data: JSON.stringify(formData),
      success: function(response) {
        Swal.fire('Success!', 'Package updated successfully.', 'success').then(() => {
          window.location.href = `${baseUrl}admin/package/list`;
        });
      },
      error: function(err) {
        Swal.fire('Error!', err.responseJSON?.message || 'Failed to update package.', 'error');
      }
    });
  });
</script>
<%- include('../Layout/Footer') %>
