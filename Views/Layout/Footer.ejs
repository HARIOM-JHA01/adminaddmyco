<script>
  $("#success-msg").delay(2000).fadeOut(1000);
  // hide error msg
  $("#error-msg").delay(2000).fadeOut(1000);
  $(document).on('click', '.logout-btn', function() {
    var id = $(this).data("id");
    var url = '<%= baseUrl %>'
    swal({
        title: "Are you sure?",
        text: "You want to Log out?",
        icon: "warning",
        buttons: true,
        dangerMode: true,
      })
      .then((willDelete) => {
        if (willDelete) {
          $.ajaxSetup({
            headers: {
              'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            }
          });
          $.ajax({
            type: "GET",
            dataType: "json",
            url: url + 'admin/logout',
            statusCode: {
              200: function(xhr) {
                console.log("heree")
                window.location.href = url + "admin/";
              }
            }
          });
        } else {}
      });
  });
</script>
