          </a>
          <ul class="submenu <%= (path == 'paypal') || (path == 'toncoin')  ? 'active' : '' %> ">
            <li class="submenu-item <%= (path == 'paypal') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/paypal">Paypal</a>
            </li>
            <!-- <li class="submenu-item <%= (path == 'toncoin') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/toncoin">Toncoin</a>
            </li> -->
          </ul>
        </li>
        <li class="sidebar-item <%= ( path == 'banner') ? 'active' : ''  %>">
          <a href="<%= baseUrl %>admin/banner" class='sidebar-link'>
            <i class="bi bi-grid-fill"></i>
            <span>Banners</span>
          </a>
        </li>
        <li
          class="sidebar-item has-sub <%= (path == 'membership') || (path == 'system') || (path == 'folder') ? 'active' : '' %> ">
          <a href="#" class='sidebar-link'>
            <i class="bi bi-stack"></i>
            <span> System Configuration</span>
          </a>
