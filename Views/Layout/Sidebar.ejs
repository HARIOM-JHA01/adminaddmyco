<div id="sidebar" class="active">
  <div class="sidebar-wrapper active">
    <div class="sidebar-header position-relative">
      <div class="d-flex justify-content-between align-items-center">
        <div class="logo">
          <tr>

            <a href="<%= baseUrl %>admin/dashboard"><img src="../assets/images/logo/logo1.png" alt="Logo" srcset=""></a>
            <a href="<%= baseUrl %>admin/dashboard"><img src="../assets/images/logo/addmyco.png" alt="Logo"
                srcset=""></a>
          </tr>
        </div>
        <div class="sidebar-toggler  x">
