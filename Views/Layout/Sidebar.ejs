            <i class="bi bi-grid-fill"></i>
            <span>Dashboard</span>
          </a>
        </li>
        <li
          class="sidebar-item has-sub <%= (path == 'freeuser') || (path == 'premium') || (path == 'donateduser') ? 'active' : '' %>">
