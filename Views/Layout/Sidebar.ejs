              <ul class="submenu pl-0">
                <li class="submenu-item  <%= (path == 'system') ? 'active' : '' %> ">
                  <a href="<%= baseUrl %>admin/system ">System Images</a>
                </li>
                <li class="submenu-item <%= (path == 'categories') ? 'active' : '' %> ">
                  <a href="<%= baseUrl %>admin/categories">Category</a>
                </li>
              </ul>
            </li>
            <li class="submenu-item <%= (path == 'folder') ? 'active' : '' %> ">
