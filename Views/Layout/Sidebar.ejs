<div id="sidebar" class="active">
  <div class="sidebar-wrapper active">
    <div class="sidebar-header position-relative">
      <div class="d-flex justify-content-between align-items-center">
        <div class="logo">
          <tr>
            <a href="<%= baseUrl %>admin/dashboard"><img src="../../assets/images/logo/logo1.png" alt="Logo" srcset=""></a>
            <a href="<%= baseUrl %>admin/dashboard"><img src="../../assets/images/logo/addmyco.png" alt="Logo"
                srcset=""></a>
          </tr>
        </div>
        <div class="sidebar-toggler  x">
          <a href="#" class="sidebar-hide d-xl-none d-block"><i class="bi bi-x bi-middle"></i></a>
        </div>
      </div>
    </div>
    <div class="sidebar-menu">
      <ul class="menu">
        <li class="sidebar-title">Menu</li>
        <li class="sidebar-item <%= ( path == 'dashboard') ? 'active' : ''  %>">
          <a href="<%= baseUrl %>admin/dashboard" class='sidebar-link'>
            <i class="bi bi-grid-fill"></i>
            <span>Dashboard</span>
          </a>
        </li>
        <li
          class="sidebar-item has-sub <%= (path == 'freeuser') || (path == 'premium') || (path == 'donateduser') ? 'active' : '' %>">
          <a href="#" class='sidebar-link'>
            <i class="bi bi-stack"></i>
            <span>Users</span>
          </a>
          <ul
            class="submenu <%= (path == 'freeuser') || (path == 'premium') || (path == 'donateduser') ? 'active' : '' %>">
            <li class="submenu-item <%= (path == 'freeuser') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/freeuser">Free Users</a>
            </li>
            <li class="submenu-item <%= (path == 'premium') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/premium">Premium Users</a>
            </li>
            <li class="submenu-item <%= (path == 'donateduser') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/donateduser">Donators</a>
            </li>

          </ul>
        </li>
        <li class="sidebar-item has-sub <%= (path == 'paypal') || (path == 'membershipstripe')  ? 'active' : '' %> ">
          <a href="#" class='sidebar-link'>
            <i class="bi bi-stack"></i>
            <span>Membership Payment</span>
          </a>
          <ul class="submenu <%= (path == 'membershipstripe') || (path == 'usdtmembership') || (path == 'telegramcoinmembership') ? 'active' : '' %> ">
            <!-- <li class="submenu-item <%= (path == 'membershipstripe') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/membershipstripe">Stripe</a>
            </li> -->
            <li class="submenu-item <%= (path == 'usdtmembership') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/usdtmembership">USDT</a>
            </li>
            <li class="submenu-item <%= (path == 'telegramcoinmembership') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/telegramcoinmembership">Telegram Coin</a>
            </li>
          </ul>
        </li>
        <li class="sidebar-item <%= ( path == 'banner') ? 'active' : ''  %>">
          <a href="<%= baseUrl %>admin/banner" class='sidebar-link'>
            <i class="bi bi-grid-fill"></i>
            <span>Banners</span>
          </a>
        </li>
        <li
          class="sidebar-item has-sub <%= (path == 'membership') || (path == 'logo') ||(path == 'system') || (path == 'folder') || (path == 'configuration') || (path == 'categories') || (path == 'paymentconfiguration') ? 'active' : '' %> ">
          <a href="#" class='sidebar-link'>
            <i class="bi bi-stack"></i>
            <span> System Configuration</span>
          </a>
          <ul
            class="submenu <%= (path == 'membership') ||(path == 'logo') || (path == 'system') || (path == 'folder') || (path == 'configuration') || (path == 'categories') || (path == 'paymentconfiguration')? 'active' : '' %> ">
            <li class="submenu-item <%= (path == 'membership') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/membership">Membership Tenure</a>
            </li>
            <li class="submenu-item <%= (path == 'logo') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/logo">Logo</a>
          </li>
            <li
              class="submenu-item arrow-color has-sub <%= (path == 'system') || (path == 'categories')  ? 'active' : '' %> ">
              <a href="#" class="sidebar-link ">Background Images</a>
              <ul class="submenu pl-0">
                <li class="submenu-item  <%= (path == 'system') || (path == 'categories')? 'active' : '' %> ">
                  <a href="<%= baseUrl %>admin/system ">System Images</a>
                </li>
                <li class="submenu-item <%= (path == 'categories') ? 'active' : '' %> ">
                  <a href="<%= baseUrl %>admin/categories">Category</a>
                </li>
              </ul>
            </li>
            <li class="submenu-item <%= (path == 'folder') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/folder">Contact Folders</a>
            </li>
            <li class="submenu-item <%= (path == 'configuration') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/configuration">Configuration </a>
            </li>
            <li class="submenu-item <%= (path == 'paymentconfiguration') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/paymentconfiguration">Payment Configuration </a>
            </li>
          </ul>
        </li>
        
        <% if (false) { %>
        <li class="sidebar-item has-sub <%= (path == 'referral') || (path == 'referralmembership')|| (path == 'referralreport') || (path == 'stripe') || (path == 'notification') ? 'active' : '' %> ">
          <a href="#" class='sidebar-link'>
            <i class="bi bi-stack"></i>
            <span>Referral</span>
          </a>
          <ul class="submenu <%= (path == 'referral') || (path == 'referralmembership') || (path == 'referralreport') || (path == 'stripe') || (path == 'notification')? 'active' : '' %> ">
          <li class="submenu-item <%= (path == 'referral') ? 'active' : '' %> ">
            <a href="<%= baseUrl %>admin/referral">Referral User</a>
            </li>
            <li class="submenu-item <%= (path == 'refmembershiptenure') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/referralmembership">Referral Membership</a>
          </li>
            </li>
            <li class="submenu-item <%= (path == 'referralreport') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/referralreport">Referral Report</a>
          </li>
          <li class="submenu-item <%= (path == 'stripe') ? 'active' : '' %> ">
            <a href="<%= baseUrl %>admin/stripedetail">Stripe Payment</a>
          </li>
          <li class="submenu-item <%= (path == 'notification') ? 'active' : '' %> ">
            <a href="<%= baseUrl %>admin/notification">Notification <span class="notification_count"></span></a>
          </li>
          </ul>
        </li>
        <% } %>
        <li class="sidebar-item has-sub <%= (path == 'partnerlist') || (path == 'partnerview') || (path == 'packagelist') || (path == 'partnerpaymentslist') || (path == 'partnerreports') ? 'active' : '' %> ">
          <a href="#" class='sidebar-link'>
            <i class="bi bi-person-badge"></i>
            <span>Partner Program</span>
          </a>
          <ul class="submenu <%= (path == 'partnerlist') || (path == 'partnerview') || (path == 'packagelist') || (path == 'partnerpaymentslist') || (path == 'partnerreports') ? 'active' : '' %> ">
            <li class="submenu-item <%= (path == 'partnerlist') || (path == 'partnerview') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/partner/list">Partner Users</a>
            </li>
            <li class="submenu-item <%= (path == 'packagelist') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/package/list">Credit Packages</a>
            </li>
            <li class="submenu-item <%= (path == 'partnerpaymentslist') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/payment/list">Credit Payments</a>
            </li>
            <!-- Renewal Prices removed -->
            <li class="submenu-item <%= (path == 'partnerreports') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/partner/reports">Reports & Analytics</a>
            </li>
          </ul>
        </li>
          <li
          class="sidebar-item has-sub <%= (path == 'createadmin') || (path == 'adminuserlist') ? 'active' : '' %>">
          <a href="#" class='sidebar-link'>
            <i class="bi bi-stack"></i>
            <span>Admin</span>
          </a>
          <ul
            class="submenu <%= (path == 'createadmin') || (path == 'adminuserlist') ? 'active' : '' %>">
            <li class="submenu-item <%= (path == 'adminuserlist') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/adminuserlist">Admin Users</a>
            </li>
            <li class="submenu-item <%= (path == 'createadmin') ? 'active' : '' %>" id="isAdmin">
              <a href="<%= baseUrl %>admin/createadmin">Create Admin</a>
            </li>
          </ul>
        </li>
    </div>
  </div>
</div>

