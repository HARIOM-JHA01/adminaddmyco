              <a href="<%= baseUrl %>admin/referralrequest">Referral Request</a>
          </li> -->
            <li class="submenu-item <%= (path == 'referral') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/referral">Referral User</a>
            </li>
            <li class="submenu-item <%= (path == 'refmembershiptenure') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/referralmembership">Referral Membership Tenure</a>
          </li>
          </ul>
        </li>

