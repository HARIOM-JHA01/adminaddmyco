            </li>
            <li class="submenu-item <%= (path == 'configuration') ? 'active' : '' %> ">
              <a href="<%= baseUrl %>admin/configuration">Configuration </a>
            </li>

          </ul>
        </li>
        <li class="sidebar-item has-sub <%= (path == 'paypal')  ? 'active' : '' %> ">
