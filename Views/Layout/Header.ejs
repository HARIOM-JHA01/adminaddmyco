<% var name = '' %>
<body>
  <div id="app">
    <div id="main" class="layout-horizontal">
      <header class="mb-5">
        <div class="header-top">
          <div class="container-fluid">
            <div class="header-top-right">
              <div class="dropdown ms-auto">
                <a href="#" id="topbarUserDropdown"
                  class="user-dropdown d-flex align-items-center dropend dropdown-toggle " data-bs-toggle="dropdown"
                  aria-expanded="false">
                  <div class="avatar avatar-md2">
                    <img src="<%= baseUrl %>assets/images/faces/164.png" alt="Avatar">
                  </div>
                  <div class="text">
                    <h6 class="user-dropdown-name" id="userName"><%= name %></h6>
                  </div>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="topbarUserDropdown">
                  <li>
                    <a class="dropdown-item" href="<%= baseUrl %>admin/ChangePassword">Change Password</a>
                  </li>
                  <!-- <li>
                    <a class="dropdown-item" href="<%= baseUrl %>admin/MyAccount">My Account</a>
                  </li> -->
                  <li>
                    <button type="button" class="btn btn-defualt logout-btn"><i class="align-middle me-1"
                        data-feather="log-out"></i> Logout</button>
                  </li>
                </ul>
              </div>

              <!-- Burger button responsive -->
              <a href="#" class="burger-btn d-block d-xl-none">
                <i class="bi bi-justify fs-3"></i>
              </a>
            </div>
            <div class="header-top-right">
            </div>
          </div>
        </div>
      </header>
    </div>
  </div>

  


<script>
  var url = '<%= baseUrl %>'
  var admin_name = '<%= name %>'
 $.ajax({
           type: "GET",
           dataType: "json",
           url: url + 'admin/getProfile',
           statusCode: {
             200: function(xhr) {
              if(xhr.data.isMasterAdmin != '1' || !xhr.data.isMasterAdmin) {
                $('#isAdmin').addClass('d-none');
              }
              $('#userName').html(xhr.data.name);
              admin_name = xhr.data.name
             }
           }
         });
 
</script>