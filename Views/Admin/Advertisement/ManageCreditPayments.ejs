<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Advertisement Credit Payments</title>
    <link rel="stylesheet" href="/assets/css/style.css" />
    <link
      rel="stylesheet"
      href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
      /* Payment container card */
      .payment-container {
        padding: 24px;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(16, 24, 40, 0.08);
        margin: 20px;
        max-width: 1200px;
      }

      .header-with-btn {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
      }

      .header-with-btn h1 {
        margin: 0;
        font-size: 32px;
        color: #1f2a44;
      }

      .header-with-btn .total-pending {
        font-size: 14px;
        color: #6b7280;
      }

      .table-responsive {
        border-radius: 8px;
        overflow: hidden;
      }

      .table.table-striped {
        margin-bottom: 0;
      }

      .table th,
      .table td {
        vertical-align: middle;
        padding: 14px 18px;
        color: #374151;
      }

      /* User column: constrain long names and show full name on hover */
      .user-col {
        max-width: 240px;
        min-width: 140px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .user-name {
        font-weight: 700;
        color: #111827;
        font-size: 14px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .user-meta {
        margin-top: 6px;
        color: #6b7280;
        font-size: 13px;
      }

      .tg-handle {
        color: #db2777;
        font-weight: 700;
      }

      .table thead th {
        font-weight: 600;
        color: #4b5563;
        background: transparent;
      }

      code {
        font-size: 13px;
        background: #f6f8fb;
        padding: 3px 6px;
        border-radius: 4px;
      }

      .status-badge {
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
        min-width: 76px;
        text-align: center;
      }

      .status-pending {
        background: #fff7ed;
        color: #92400e;
      }

      .status-approved {
        background: #effaf1;
        color: #065f46;
      }

      .status-rejected {
        background: #fff1f2;
        color: #7f1d1d;
      }

      .action-buttons {
        display: flex;
        gap: 8px;
        align-items: center;
      }

      .btn-small {
        padding: 7px 12px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
        transition: transform 0.08s ease, box-shadow 0.08s ease;
      }

      .btn-small:active {
        transform: translateY(1px);
      }

      .btn-approve {
        background: #10b981;
        color: white;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.12);
      }
      .btn-approve:hover {
        background: #0ea46f;
      }

      .btn-reject {
        background: #ef4444;
        color: white;
        box-shadow: 0 2px 8px rgba(239, 68, 68, 0.12);
      }
      .btn-reject:hover {
        background: #e11d48;
      }

      /* Responsive tweaks */
      @media (max-width: 768px) {
        .payment-container {
          padding: 16px;
          margin: 12px;
        }
        .header-with-btn h1 {
          font-size: 22px;
        }
        .table th,
        .table td {
          padding: 10px 8px;
          font-size: 14px;
        }
        .btn-small {
          padding: 6px 10px;
          font-size: 12px;
        }
      }
    </style>
  </head>
  <body>
    <%- include('../../Layout/Header') %> <%- include('../../Layout/Sidebar') %>
    <div id="main">
      <div class="payment-container">
        <div class="header-with-btn">
          <h1>Advertisement Credit Payments</h1>
          <div>
            <span style="font-size: 14px; color: #666">
              Total Pending:
              <strong style="color: #f39c12">
                <%= payments.filter(p => p.status === 0).length %>
              </strong>
            </span>
          </div>
        </div>

        <% if (payments.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-striped mb-0" id="payments_table">
            <thead>
              <tr>
                <th>No.</th>
                <th>TGUser</th>
                <th>Transaction ID</th>
                <th>Wallet Address</th>
                <th>Amount (USDT)</th>
                <th>Credits</th>
                <th>Package</th>
                <th>Date</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% var i = 1; payments.forEach(function(payment) { %>
              <tr data-id="<%= payment._id %>">
                <td><%= i %></td>
                <td class="user-col">
                  <% const handle = payment.user && (payment.user.tgid || payment.user.username) ? (payment.user.tgid || payment.user.username) : null; %>
                  <% const displayName = handle || (((payment.user && (payment.user.firstname || '')) + ' ' + (payment.user && (payment.user.lastname || ''))).trim()); %>
                  <div class="user-name" title="<%= displayName %>">
                    <% if (handle) { %>
                      <a href="https://t.me/<%= encodeURIComponent(handle) %>" target="_blank" rel="noopener noreferrer" class="tg-handle"><%= handle %></a>
                    <% } else { %>
                      <%= displayName %>
                    <% } %>
                  </div>
                </td>
                <td>
                  <code style="background: #f5f5f5; padding: 2px 5px">
                    <%= payment.transactionId %>
                  </code>
                </td>
                <td>
                  <code
                    style="
                      background: #f5f5f5;
                      padding: 2px 5px;
                      font-size: 11px;
                    "
                  >
                    <%= payment.walletAddress %>
                  </code>
                </td>
                <td><strong>$<%= payment.amount %></strong></td>
                <td><strong><%= payment.credits %></strong></td>
                <td><%= payment.package.name %></td>
                <td><%= moment(payment.createdAt).format('DD/MM/YYYY') %></td>
                <td>
                  <span
                    class="status-badge status-<%= payment.status === 0 ? 'pending' : payment.status === 1 ? 'approved' : 'rejected' %>"
                  >
                    <%= payment.statusLabel %>
                  </span>
                </td>
                <td>
                  <% if (payment.status === 0) { %>
                  <div class="action-buttons">
                    <button
                      class="btn-small btn-approve"
                      onclick="approvePayment('<%= payment._id %>')"
                    >
                      Approve
                    </button>
                    <button
                      class="btn-small btn-reject"
                      onclick="rejectPayment('<%= payment._id %>')"
                    >
                      Reject
                    </button>
                  </div>
                  <% } else if (payment.status === 1) { %>
                  <span style="color: #28a745; font-weight: 600"
                    >✓ Approved</span
                  >
                  <% } else { %>
                  <span style="color: #dc3545; font-weight: 600"
                    >✗ Rejected</span
                  >
                  <% } %>
                </td>
              </tr>
              <% i++; }) %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div style="padding: 40px; text-align: center; color: #999">
          <p>No payment requests found</p>
        </div>
        <% } %>
      </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
    <script>
      $(document).ready(function () {
        if ($("#payments_table").length) {
          $("#payments_table").DataTable({ order: [[7, "desc"]] });
        }
      });

      function approvePayment(paymentId) {
        Swal.fire({
          title: "Approve Payment?",
          text: "Credits will be added to user's account",
          icon: "question",
          showCancelButton: true,
          confirmButtonColor: "#28a745",
          cancelButtonColor: "#6c757d",
          confirmButtonText: "Yes, approve!",
        }).then(async (result) => {
          if (!result.isConfirmed) return;

          const row = document.querySelector(`tr[data-id="${paymentId}"]`);
          const approveBtn = row ? row.querySelector(".btn-approve") : null;
          const rejectBtn = row ? row.querySelector(".btn-reject") : null;
          const origApproveText = approveBtn ? approveBtn.innerHTML : "";

          if (approveBtn) {
            approveBtn.disabled = true;
            approveBtn.innerHTML = "Approving...";
          }
          if (rejectBtn) {
            rejectBtn.disabled = true;
          }

          try {
            const response = await fetch(
              `/api/v1/admin/advertisement/credit-payments/${paymentId}/approve`,
              {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({}),
              }
            );

            let data = null;
            try {
              data = await response.json();
            } catch (e) {
              /* non-json response */
            }

            if (!response.ok) {
              const msg =
                (data && data.message) || `Server returned ${response.status}`;
              Swal.fire("Error!", msg, "error");
              return;
            }

            if (data && data.success) {
              Swal.fire(
                "Approved!",
                "Payment has been approved.",
                "success"
              ).then(() => location.reload());
            } else {
              Swal.fire(
                "Error!",
                (data && data.message) || "Failed to approve payment",
                "error"
              );
            }
          } catch (err) {
            console.error("Error approving payment:", err);
            Swal.fire("Error!", "Error approving payment", "error");
          } finally {
            if (approveBtn) {
              approveBtn.disabled = false;
              approveBtn.innerHTML = origApproveText;
            }
            if (rejectBtn) {
              rejectBtn.disabled = false;
            }
          }
        });
      }

      function rejectPayment(paymentId) {
        Swal.fire({
          title: "Reject Payment?",
          text: "User will be notified of rejection",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#dc3545",
          cancelButtonColor: "#6c757d",
          confirmButtonText: "Yes, reject!",
          input: "textarea",
          inputPlaceholder: "Rejection reason (required)",
          inputAttributes: {
            "aria-label": "Rejection reason",
          },
          inputValidator: (value) => {
            if (!value) {
              return "Please provide a rejection reason";
            }
          },
        }).then(async (result) => {
          if (!result.isConfirmed) return;
          const reason = result.value;

          const row = document.querySelector(`tr[data-id="${paymentId}"]`);
          const approveBtn = row ? row.querySelector(".btn-approve") : null;
          const rejectBtn = row ? row.querySelector(".btn-reject") : null;
          const origRejectText = rejectBtn ? rejectBtn.innerHTML : "";

          if (approveBtn) approveBtn.disabled = true;
          if (rejectBtn) {
            rejectBtn.disabled = true;
            rejectBtn.innerHTML = "Rejecting...";
          }

          try {
            const response = await fetch(
              `/api/v1/admin/advertisement/credit-payments/${paymentId}/reject`,
              {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ reason }),
              }
            );

            let data = null;
            try {
              data = await response.json();
            } catch (e) {}

            if (!response.ok) {
              const msg =
                (data && data.message) || `Server returned ${response.status}`;
              Swal.fire("Error!", msg, "error");
              return;
            }

            if (data && data.success) {
              Swal.fire(
                "Rejected!",
                "Payment has been rejected.",
                "success"
              ).then(() => location.reload());
            } else {
              Swal.fire(
                "Error!",
                (data && data.message) || "Failed to reject payment",
                "error"
              );
            }
          } catch (err) {
            console.error("Error rejecting payment:", err);
            Swal.fire("Error!", "Error rejecting payment", "error");
          } finally {
            if (approveBtn) approveBtn.disabled = false;
            if (rejectBtn) {
              rejectBtn.disabled = false;
              rejectBtn.innerHTML = origRejectText;
            }
          }
        });
      }
    </script>

    <%- include('../../Layout/Footer') %>
  </body>
</html>
