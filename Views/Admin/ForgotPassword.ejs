<!DOCTYPE html>
<html lang="en">
<!-- Mirrored from zuramai.github.io/mazer/demo/auth-forgot-password.html by HTTrack Website Copier/3.x [XR&CO'2014], Thu, 07 Jul 2022 12:33:51 GMT -->
<!-- Added by HTTrack -->
<meta http-equiv="content-type" content="text/html;charset=utf-8" /><!-- /Added by HTTrack -->

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title> Login - MynameCard Admin Dashboard</title>
  <link rel="stylesheet" href="/assets/css/main/app.css">
  <link rel="stylesheet" href="/assets/css/pages/auth.css">
  <link rel="shortcut icon" href="/assets/images/logo/favicon.svg" type="image/x-icon">
  <link rel="shortcut icon" href="/assets/images/logo/favicon.png" type="image/png">
</head>

<body>
  <div id="auth">
    <div class="row h-100">
      <div class="col-lg-5 col-12">
        <div id="auth-left">
          <div class="auth-logo">
            <a href="<%= baseUrl %>admin/forgotpassword"><img src="../assets/images/logo/logo1.png" alt="Logo"></a>
            <a href="index.html"><img src="../assets/images/logo/addmyco.png" alt="Logo"></a>
          </div>
          <h1 class="auth-title">Forgot Password</h1>
          <p class="auth-subtitle mb-5">Input your email and we will send you reset password link.</p>
          <% if(typeof message=="string" ) { %>
            <p class="text-danger">
              <%= message %>
            </p>
            <% } %>
              <form action="<%= baseUrl %>admin/ForgotPassword" method="post">
                <div class="form-group position-relative has-icon-left mb-4">
                  <input type="email" class="form-control form-control-xl" onkeyup="eventHandler(this)" id="email"
                    name="email" placeholder="Email">
                  <% if(typeof errors=="object" ) { %>
                    <p style="color: red;" class="email">
                      <%= errors.email %>
                    </p>
                    <% } %>
                      <div class="form-control-icon">
                        <i class="bi bi-envelope"></i>
                      </div>
                </div>
                <button class="btn btn-primary btn-block btn-lg shadow-lg mt-5">Send</button>
              </form>
              <div class="text-center mt-5 text-lg fs-4">
                <p class='text-gray-600'>Remember your account? <a href="<%= baseUrl %>/" class="font-bold">Log
                    in</a>.
                </p>
              </div>
        </div>
      </div>
      <div class="col-lg-7 d-none d-lg-block">
        <div id="auth-right">
        </div>
      </div>
    </div>
  </div>
</body>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
  function eventHandler(e) {
    const {
      id,
      name,
      value
    } = e
    if (value.length > 0) {
      $(`.${id}`).text("")
    }
  }
</script>

</html>