<%- include('../Layout/header') %>
  <div id="app"></div>
  <%- include('../Layout/sidebar') %>
    <div id="main">
      <section id="basic-vertical-layouts">
        <div class="page-title">
          <div class="row">
            <div class="col-12 col-md-6 order-md-1 order-last page-head mb-3">
              <a href="<%= baseUrl %>admin/dashboard" class="text-primary"><i class="fas fa-arrow-left me-2"></i></a>
              <h3 class="mb-0">Change Password</h3>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
              <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item"><a href="<%= baseUrl %>admin/dashboard">Dashboard</a></li>
                  <li class="breadcrumb-item active" aria-current="page">Change Password</li>
                </ol>
              </nav>
            </div>
          </div>
        </div>
        <div class="row match-height">
          <div class="card">
            <div class="card-content">
              <div class="card-body">
                <div class="col-xl-4 col-md-5">
                  <form class="form form-vertical" id="change-password-form" novalidate="novalidate"
                    action="<%= baseUrl %>admin/ChangePassword" method="post">
                    <input type="hidden" name="_token" value="k5NaW0f5PI5b1BXkRwRDGcViA4ts9R1jl84Cv7em">
                    <div class="form-body">
                      <div class="row">
                        <div class="col-12">
                          <div class="form-group">
                            <% if(typeof message=="string" ) { %>
                              <p class="text-danger">
                                <%= message %>
                              </p>
                              <% } %>
                                <label for="current_password">Current Password</label>
                                <input type="password" id="current_password" onkeyup="eventHandler(this)"
                                  class="form-control current-password" name="current_password"
                                  placeholder="Current Password" value="">
                                <% if(typeof errors=="object" ) { %>
                                  <p style="color: red;" class="current_password">
                                    <%= errors.current_password %>
                                  </p>
                                  <% } %>
                          </div>
                          <div class="error-msg-current-password d-none" id="error-current-password">
                            <p class="error"></p>
                          </div>
                          <div class="form-group">
                            <label for="new_password">New Password</label>
                            <input type="password" id="new_password" onkeyup="eventHandler(this)"
                              class="form-control new-password" name="new_password" placeholder="New Password" value="">
                            <% if(typeof errors=="object" ) { %>
                              <p style="color: red;" class="new_password">
                                <%= errors.new_password %>
                              </p>
                              <% } %>
                          </div>
                          <div class="error-msg-new-password d-none" id="error-new-password">
                            <p class="error"></p>
                          </div>
                          <div class="form-group">
                            <label for="password_confirmation">Confirm Password</label>
                            <input type="password" id="confirm_password" onkeyup="eventHandler(this)"
                              class="form-control password-confirmation" name="confirm_password"
                              placeholder="Confirm Password" value="">
                            <% if(typeof errors=="object" ) { %>
                              <p style="color: red;" class="confirm_password">
                                <%= errors.confirm_password %>
                              </p>
                              <% } %>
                          </div>
                          <div class="error-msg-confirm-password d-none" id="error-confirm-password">
                            <p class="error"></p>
                          </div>
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                          <button id="submit_btn" class="btn btn-primary me-1 mb-1"><a
                              href="<%= baseUrl %>admin/dashboard"></a>
                            <i class="spin-ico"><span class="spinner-border spinner-border-sm" role="status"
                                aria-hidden="true"></span></i>
                            <span>Change</span></button>
                        </div>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <footer>
        <div class="footer clearfix mb-0 text-muted">
          <div class="float-start">
            <p>2023 &copy; All rights are reserved</p>
          </div>
         
        </div>
      </footer>
    </div>

    <script>
      function eventHandler(e) {
        const {
          id,
          name,
          value
        } = e
        if (value.length > 0) {
          $(`.${id}`).text("")
        }
      }
    </script>

    <%- include('../Layout/footer') %>