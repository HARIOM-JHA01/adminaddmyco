<!DOCTYPE html>
<html lang="en">
<!-- Mirrored from zuramai.github.io/mazer/demo/auth-register.html by HTTrack Website Copier/3.x [XR&CO'2014], Thu, 07 Jul 2022 12:33:51 GMT -->
<!-- Added by HTTrack -->
<meta http-equiv="content-type" content="text/html;charset=utf-8" /><!-- /Added by HTTrack -->

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title> Login - MyNameCard Admin Dashboard</title>
  <link rel="stylesheet" href="/assets/css/main/app.css">
  <link rel="stylesheet" href="/assets/css/pages/auth.css">
  <link rel="shortcut icon" href="/assets/images/logo/favicon.svg" type="image/x-icon">
  <link rel="shortcut icon" href="/assets/images/logo/favicon.png" type="image/png">
</head>

<body>
  <div id="auth">
    <div class="row h-100">
      <div class="col-lg-5 col-12">
        <form action="<%= baseUrl %>admin/Register" method="post">
          <div id="auth-left">
            <div class="auth-logo">
              <a href="<%= baseUrl %>admin/signup"><img src="../assets/images/logo/logo1.png" alt="Logo"></a>
              <a href="index.html"><img src="../assets/images/logo/addmyco.png" alt="Logo"></a>
            </div>
            <h1 class="auth-title">Sign Up</h1>
            <p class="auth-subtitle mb-5">Input your data to register to our website.</p>
            <% if(typeof message=="string" ) { %>
              <p class="text-danger">
                <%= message %>
              </p>
              <% } %>

                <!-- <input type="hidden" name="role" value="1" /> -->
                <div class="form-group position-relative has-icon-left mb-4">
                  <input type="text" id="email" class="form-control form-control-xl" onkeyup="eventHandler(this)"
                    name="email" placeholder="Email">
                  <% if(typeof errors=="object" ) { %>
                    <p style="color: red;" class="email">
                      <%= errors.email %>
                    </p>
                    <% } %>
                      <div class="form-control-icon">
                        <i class="bi bi-envelope"></i>
                      </div>
                </div>
                <div class="form-group position-relative has-icon-left mb-4">
                  <input type="text" id="name" class="form-control form-control-xl" onkeyup="eventHandler(this)"
                    placeholder="Username" name="name">
                  <% if(typeof errors=="object" ) { %>
                    <p style="color: red;" class="name">
                      <%= errors.name %>
                    </p>
                    <% } %>
                      <div class="form-control-icon">
                        <i class="bi bi-person"></i>
                      </div>
                </div>
                <div class="form-group position-relative has-icon-left mb-4">
                  <input type="password" id="password" class="form-control form-control-xl" onkeyup="eventHandler(this)"
                    name="password" placeholder="Password">
                  <% if(typeof errors=="object" ) { %>
                    <p style="color: red;" class="password">
                      <%= errors.password %>
                    </p>
                    <% } %>
                      <div class="form-control-icon">
                        <i class="bi bi-shield-lock"></i>
                      </div>
                </div>
                <div class="form-group position-relative has-icon-left mb-4">
                  <input type="password" id="confirmpassword" class="form-control form-control-xl"
                    onkeyup="eventHandler(this)" name="confirmpassword" placeholder="Confirm Password">
                  <% if(typeof errors=="object" ) { %>
                    <p style="color: red;" class="confirmpassword">
                      <%= errors.confirmpassword %>
                    </p>
                    <% } %>
                      <div class="form-control-icon">
                        <i class="bi bi-shield-lock"></i>
                      </div>
                </div>
                <button class="btn btn-primary btn-block btn-lg shadow-lg mt-5">Sign Up</button>
        </form>
        <div class="text-center mt-5 text-lg fs-4">
          <p class='text-gray-600'>Already have an account? <a href="<%= baseUrl %>admin/" class="font-bold">Log
              in</a>.</p>
        </div>
      </div>
      </form>
    </div>
    <div class="col-lg-7 d-none d-lg-block">
      <div id="auth-right">
      </div>
    </div>
  </div>
  </div>
</body>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
  function eventHandler(e) {
    const {
      id,
      name,
      value
    } = e
    if (value.length > 0) {
      $(`.${id}`).text("")
    }
  }
</script>

</html>