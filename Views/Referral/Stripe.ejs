<%- include('../Layout/Header') %>
import session from "express-session"
<%- include('../Layout/Sidebar') %>

<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3><a href="<%= baseUrl %>admin/dashboard" class="text-primary"><i class="fas fa-arrow-left me-2"></i></a>Stripe Details</h3>
        </div>
        <div class="col-12 col-md-6 order-md-2 order-first d-flex justify-content-end align-items-center">
          <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end me-4 mb-0">
            <ol class="breadcrumb" style="margin-bottom: 0px;">
              <li class="breadcrumb-item"><a href="<%= baseUrl %>admin/dashboard">Dashboard</a></li>
            </ol>
          </nav>
          <a href="<%= baseUrl %>admin/exportstrapedata"><button type="button" class="btn btn-primary btn-sm ">Export Data</button></a>
        </div>
      </div>
    </div>
    <section class="section">
      <div class="card">
        <div class="card-body">
          <div class="dataTable-container">
            <table class="table table-striped dataTable-table" id="table1">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Referral TG ID</th>
                  <th>Member TG ID</th>
                  <th>Tenure</th>
                  <th>Price(HK$)</th>
                  <th>Payment Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% var i=1; data.forEach(function(v) { %>
                <tr data-id="<%= v.id%>">
                  <td><span class="name-field">
                      <%= i %>
                    </span></td>
                  <td><span class="name-field">
                      <%= v.referral_tgid %>
                    </span></td>
                  <td><span class="name-field">
                      <%= v.member_tgid %>
                    </span></td>
                  <td><span class="name-field">
                        <% if(v.tenure != '' && v.tenure != 0) { %>
                          <%= v.tenure%> Years
                       <% } %>
                    </span></td>
                  <td><span class="name-field">
                      <%= v.price%> HK$
                    </span></td>
                  <td><span class="name-field">
                      <%= v.date%>
                    </span></td>
                    <td>
                        <button type="button" data-id="<%= v.id %>" id="refresh"
                            class="btn icon  icon-left btn-danger btn-sm delete-data"><i
                                class="bi bi-trash"></i> </button>
                    </td>
                </tr>
                <% i++ %>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
    <footer>
      <div class="footer clearfix mb-0 text-muted">
        <div class="float-start">
          <p>2023 &copy; All rights are reserved</p>
        </div>
      </div>
    </footer>
  </div>
  <!-- Modal -->
  <div class="modal fade bd-example-modal-lg" id="viewQRCode" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title w-100" id="exampleModalLabel">
            Banner Preview
          </h5>
          <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">×</span>
          </button>
        </div>
        <!--Modal body with image-->
        <div class="modal-body">
          <img src="" class="img-fluid" id="image">
        </div>
      </div>
    </div>
  </div>
  <script>
    $(document).ready(function () {
        var table = $('#table1').DataTable();
    });
</script>
  
  <script>
    let isTost = '<%= session.isTost %>'
    let msg = '<%= session.tostMsg %>'
    let tostBackground = '<%= session.tostBackground %>'
    if (isTost == "true") {
      Toastify({
        text: msg,
        duration: 3000,
        newWindow: true,
        close: true,
        gravity: "top", // `top` or `bottom`
        position: "right", // `left`, `center` or `right`
        stopOnFocus: true, // Prevents dismissing of toast on hover
        style: {
          background: tostBackground,
        },
      }).showToast();
      '<%= session.isTost = "false"%>'
    }
  </script>
<script>
  const baseUrl = '<%= baseUrl %>';
  $(document).on('click', '.delete-data', function() {
    var id = $(this).data("id");
    console.log("id", id);

    swal({
        title: "Are you sure?",
        text: "You want to delete this stripepaymentl?",
        icon: "warning",
        buttons: true,
        dangerMode: true,
      })
      .then((willDelete) => {
        if (willDelete) {
          $.ajax({
            type: "GET",
            url: `${baseUrl}admin/deletestripedetail?id=${id}`,
            dataType: "json",
            statusCode: {
              200: function(xhr) {
                dataResult = xhr;
                $(`tr[data-id="${id}"]`).remove();
                console.log(dataResult.message)
                Toastify({
                  text: "Deleted successfully...",
                  duration: 3000,
                  newWindow: true,
                  close: true,
                  gravity: "top", // `top` or `bottom`
                  position: "right", // `left`, `center` or `right`
                  stopOnFocus: true, // Prevents dismissing of toast on hover
                  style: {
                    background: "#ff2c2c",
                  },
                }).showToast();
              }
            },
          });
        }
      });
  });
</script>

  <%- include('../Layout/Footer') %>