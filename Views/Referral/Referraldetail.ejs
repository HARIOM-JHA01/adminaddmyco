<%- include('../Layout/Header') %>
import session from "express-session"
<%- include('../Layout/Sidebar') %>

<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-  6 order-md-1 order-last">
          <h3><a href="<%= baseUrl %>admin/referralreport" class="text-primary"><i class="fas fa-arrow-left me-2"></i></a>Referral Details</h3>
        </div>  
        <div class="col-12 col-md-6 order-md-2 order-first">
          <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="<%= baseUrl %>admin/dashboard">Dashboard</a></li>`
            </ol>
          </nav>
        </div>
      </div>
    </div>
    <section class="section">
      <div class="card">
        <div class="card-body">
          <div class="dataTable-container">
            <table class="table table-striped dataTable-table" id="table1">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Referral TG</th>
                  <th>Free Member TG</th>
                  <th>Tenure Of Upgrade</th>
                  <th>Price</th>
                  <th>Date of join to premium</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
               
                <% var i=1; referraldetail.forEach(function(v) { %>
                <tr data-id="<%= v._id%>">
                  <td><span class="name-field">
                      <%= i %>
                    </span></td>
                  <td><span class="name-field">
                      <%= v.referral_user_tgid %>
                    </span></td>
                  <td><span class="name-field">
                      <%= v.freemember_tgid%>
                    </span></td>
                  <td><span class="name-field">
                      <%= v.membership_period%>
                    </span></td>
                  <td><span class="name-field">
                      <%= v.price%>
                    </span></td>
                  <td><span class="name-field">
                      <%= v.join_date%>
                    </span></td>
                    <td>
                      <button type="button" data-id="<%= v._id %>" id="refresh" class="btn icon icon-left btn-danger btn-sm delete-data"><i class="bi bi-trash"></i> </button>
                    </td>
                </tr>
                <% i++ %>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
    <footer>
      <div class="footer clearfix mb-0 text-muted">
        <div class="float-start">
          <p>2023 &copy; All rights are reserved</p>
        </div>
      </div>
    </footer>
  </div>
  <!-- Modal -->
  <div class="modal fade bd-example-modal-lg" id="viewQRCode" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title w-100" id="exampleModalLabel">
            Banner Preview
          </h5>
          <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">×</span>
          </button>
        </div>
        <!--Modal body with image-->
        <div class="modal-body">
          <img src="" class="img-fluid" id="image">
        </div>
      </div>
    </div>
  </div>
  <script>
    $(document).ready(function () {
        var table = $('#table1').DataTable();
    });
</script>
  
  <script>
    let isTost = '<%= session.isTost %>'
    let msg = '<%= session.tostMsg %>'
    let tostBackground = '<%= session.tostBackground %>'
    if (isTost == "true") {
      Toastify({
        text: msg,
        duration: 3000,
        newWindow: true,
        close: true,
        gravity: "top", // `top` or `bottom`
        position: "right", // `left`, `center` or `right`
        stopOnFocus: true, // Prevents dismissing of toast on hover
        style: {
          background: tostBackground,
        },
      }).showToast();
      '<%= session.isTost = "false"%>'
    }
  </script>

  

  <%- include('../Layout/Footer') %>