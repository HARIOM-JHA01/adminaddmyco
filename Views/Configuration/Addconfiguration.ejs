<%- include('../Layout/Header') %>
<!DOCTYPE html>
<html lang="en">

<!-- Mirrored from zuramai.github.io/mazer/demo/table-datatable.html by HTTrack Website Copier/3.x [XR&CO'2014], Thu, 07 Jul 2022 12:33:41 GMT -->
<!-- Added by HTTrack --><meta http-equiv="content-type" content="text/html;charset=utf-8" /><!-- /Added by HTTrack -->

<body>
    <div id="app">
        <%- include('../Layout/Sidebar') %>
        <div id="main">
            <header class="mb-3">
                <a href="#" class="burger-btn d-block d-xl-none">
                    <i class="bi bi-justify fs-3"></i>
                </a>
            </header>
            

            <section class="section">
                <div class="page-heading">
                    <div class="page-title">
                        <div class="row">
                           
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6 order-md-1 order-last">
                            <h3><a href="<%= baseUrl %>admin/configuration" class="text-primary"><i class="fas fa-arrow-left me-2"></i>Add Configuration</h3>
                        </div>
                        <div class="col-12 col-md-6 order-md-2 order-first">
                            <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="<%= baseUrl %>admin/dashboard">Dashboard</a></li>
                                    
                                </ol>
                            </nav>
                        </div>
                        
                    </div>
                <div class="card">
                    <div class="card-content">
                        <div class="card-body">
                            <div class="col-xl-4 col-md-5">
                                <form class="form form-vertical" action="<% baseUrl %>configuration"  method="post" id="category_form" novalidate="novalidate">
                                    <input type="hidden" name="_token" value="PnhjGlM8lhVabo6sx6zR7OnlXpzV4MHJmqNVXF08">      
                                                              <div class="form-body">
                                        <div class="row">
                                            <div class="col-12">
        
                                                <div class="form-group">
                                                    <% if(typeof message == "string") { %>  <p  class="text-danger"><%= message %></p> <% } %>
                                                    <label for="category_title">Key</label>
                                                    <input type="text"onkeyup="eventHandler(this)" id="configkey" class="form-control valid" name="configkey" placeholder=" Key" value="" aria-invalid="false">
                                                    <% if(typeof errors == "object") { %><p style="color: red;" class="configkey">
                                                        <%= errors.configkey %></p> <% } %>
                                                </div>
                                               
                                                <div class="form-group">
                                                    <label for="category_title"> Value </label>
                                                    <input type="text"onkeyup="eventHandler(this)" id="configvalue" class="form-control valid" name="configvalue" placeholder=" Value" value="" aria-invalid="false">
                                                    <% if(typeof errors == "object") { %><p style="color: red;" class="configvalue">
                                                        <%= errors.configvalue %></p> <% } %>
                                                    </div>
                                               
                                               
                                            </div>
                                    <div class="col-12 d-flex justify-content-end">
                                                <button type="submit" id="submit_btn" class="btn btn-primary me-1 mb-1">
                                                <span>Save</span></button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
</div>

        </div>
    </div>
 
    <script src="assets/js/app.js"></script>
    
<script src="assets/js/extensions/simple-datatables.js"></script>

</body>
<script>
    function eventHandler(e) {
        const {
            id,
            name,
            value
        } = e
        if (value.length > 0) {
            $(`.${id}`).text("")
        }
    }
</script>

<%- include('../Layout/Footer') %>