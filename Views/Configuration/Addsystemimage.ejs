<%- include('../Layout/Header') %>
<div id="app">
  <%- include('../Layout/Sidebar') %>
  <div id="main">
    <div class="page-heading">
      <div class="page-title">
        <div class="row">
        </div>
      </div>
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3><a href="<%= baseUrl %>admin/system" class="text-primary"><i class="fas fa-arrow-left me-2"></i>Add Image</h3>
        </div>
        <div class="col-12 col-md-6 order-md-2 order-first">
          <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="<%= baseUrl %>admin/dashboard">Dashboard</a></li>

              <li class="breadcrumb-item active" aria-current="page">Add</li>
            </ol>
          </nav>
        </div>
      </div>
      <section class="section">
        <div class="card">
          <div class="card-content">
            <div class="card-body">
              <div class="col-xl-7 col-md-8">
                <form class="form form-vertical" id="assessment_form" action="<% baseUrl %>system" method="post" novalidate="novalidate" enctype="multipart/form-data">
                  <input type="hidden" name="_token" value="f9AhpSnBOfj6mWQNv1h3AqXMECftDNKFyoO2zp7C">
                  <div class="form-body">
                    <input type="hidden" name="id" value="<%= categories._id %>">
                    <div class="form-body">
                      <div class="row">
                        <div class="form-group cat-div">
                          <label for="category_id">Choose Category</label>
                          <select data-placeholder="Select Category" name="categoryname" onkeyup="eventHandler(this)" class="form-control categories" tabindex="8">

                            <option value="" selected="">Select Category</option>
                            <%
                                    var i = 1;
                                    categories.forEach(function(v)  {  %>
                            <option value="<%= v._id %>"><%= v.categoryname %></option>
                            <% i++ %>
                            <% }) %>
                          </select>
                          <% if(typeof errors == "object") { %><p style="color: red;" class="categoryname">
                            <%= errors.categoryname %></p> <% } %>
                        </div>

                        <div class="form-group thumbnail-div">
                          <label for="thumbnail">Choose Images* (Size must be 750*969 pixel - you can select multiple images)</label>
                          <input name="thumbnail" multiple type="file" onchange="eventHandler(this)" class="dropify" data-allowed-file-extensions="png jpg jpeg" id="thumbnail" />
                          <% if(typeof errors == "object") { %><p style="color: red;" class="thumbnail">
                            <%= errors.thumbnail %></p> <% } %>
                          <P class="error image_error"></P>
                          <div class="col-md-12 mt-4 thumbnail-file d-none">
                            <div class="form-group mb-0">
                              <label for="">Chosen Files</label>
                              <ul class="thumbnail-list ps-0">
                              </ul>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- <input name="thumbnail" data-allowed-file-extensions="png jpg jpeg" value="<%= system.Thumbnail %>" id="thumbnail" /> -->
                      <div class="col-12 d-flex justify-content-end">
                        <button type="submit" id="submit_btn" class="btn btn-primary me-1 mb-1"><span>Save</span></button>
                      </div>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </div>
      </section>
      <footer>
        <div class="footer clearfix mb-0 text-muted">
          <div class="float-start">
            <p>2023 &copy; All rights are reserved</p>
          </div>

        </div>
      </footer>
    </div>
  </div>
</div>
<script>
  function eventHandler(e) {
    const {
      id,
      name,
      value
    } = e
    console.log("name", name)
    if (value.length > 0) {
      $(`.${name}`).text("")
    }
  }
</script>

<script>
  $('.dropify').dropify({
    tpl: {
      wrap: '<div class="dropify-wrapper"></div>',
      loader: '<div class="dropify-loader"></div>',
      message: '<div class="dropify-message"><span class="icon" ><svg width="24" height="27" viewBox="0 0 24 27" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M15.6484 0.766724H6.77911C4.03378 0.766724 1.66711 3.0429 1.66711 5.85233V20.4954C1.66711 23.4631 3.87778 25.7965 6.77911 25.7965H17.4298C20.1764 25.7965 22.4031 23.3049 22.4031 20.4954V7.96213L15.6484 0.766724Z" stroke="#0ABAB5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M15.2982 0.750732V4.71802C15.2982 6.65462 16.8302 8.22572 18.7236 8.22981C20.4782 8.2339 22.2742 8.23526 22.3956 8.22708" stroke="#0ABAB5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path fill-rule="evenodd" clip-rule="evenodd" d="M12.0577 9.35134C11.9165 9.2063 11.7227 9.12449 11.5203 9.12451C11.3178 9.12453 11.124 9.20637 10.9828 9.35143L7.19885 13.2396C6.90996 13.5365 6.91641 14.0113 7.21325 14.3002C7.51009 14.5891 7.98492 14.5826 8.27381 14.2858L10.7709 11.7199V18.8394C10.7709 19.2536 11.1067 19.5894 11.5209 19.5894C11.9351 19.5894 12.2709 19.2536 12.2709 18.8394V11.7207L14.7683 14.2859C15.0572 14.5827 15.532 14.589 15.8288 14.3001C16.1256 14.0112 16.132 13.5363 15.8431 13.2395L12.0577 9.35134Z" fill="#0ABAB5"/></svg></span> <p>Drag and Drop to <br/>Upload or <span>Browse</span></p></div>',
      // preview: '<div class="dropify-preview"><span class="dropify-render"></span><div class="dropify-infos"><div class="dropify-infos-inner"><p class="dropify-infos-message">Drag and drop or click to <span>replace</span></p></div></div></div>',
      filename: '<p class="dropify-filename"><span class="file-icon"></span> <span class="dropify-filename-inner"></span></p>',
      clearButton: '<button type="button" class="dropify-clear"> remove</button>',
      errorsContainer: '<div class="dropify-errors-container"><ul></ul></div>'
    }
  });
</script>
<script>
  $('#thumbnail').change(function(event) {
    var img = new Image();
    var tmppath1 = URL.createObjectURL(event.target.files[0]);
    img.src = tmppath1;
    img.onload = function() {
     
      if (img.width > 750 && img.height > 969) {
        $(".image_error").html("Your Image Size must be 750*969 pixel");
        $("#submit_btn").attr("disabled", true);
      } else if (event.target.files[0].size > (200 * 1024)) {
        $(".image_error").html("Image size should be less than 200 KB")
        $("#submit_btn").attr("disabled", true);
      } else {
        $("#submit_btn").attr("disabled", false);
        $(".image_error").html('');
      }

    }




    function validateFile(th, file) {
      var video = document.createElement('video');
      video.preload = 'metadata';
      video.onloadedmetadata = function() {
        window.URL.revokeObjectURL(video.src);
        if (video.duration > 600.00) {
          $(th).closest('.setvideo').find('.error').removeClass('d-none');
          $('.setvideo').find(".dropify-clear").trigger("click");
          return;
        }
        $(th).closest('.setvideo').find('.error').addClass('d-none');
      }
      video.src = URL.createObjectURL(file);
    }

    $(".videoset").on("change", function(e) {
      var file = this.files[0];
      let aa = validateFile(this, file);
    })



  });
</script>

<%- include('../Layout/Footer') %>