<%- include('../Layout/Header') %>
    <link rel="stylesheet" href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css">
    <%- include('../Layout/Sidebar') %>
        <div id="main">
            <div class="page-heading">
                <div class="page-title mb-3">
                    <div class="row">
                        <div class="col-12 col-md-6 order-md-1 order-last">
                            <h3><a href="<%= baseUrl %>admin/membership" class="text-primary"><i
                                        class="fas fa-arrow-left me-2"></i></a> Edit Membership</h3>
                        </div>
                        <div class="col-12 col-md-6 order-md-2 order-first">
                            <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="<%= baseUrl %>admin/dashboard">Dashboard</a></li>

                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
                <section class="section">
                    <div class="card">
                        <div class="card-content">
                            <div class="card-body">
                                <div class="col-xl-4 col-md-5">
                                    <form class="form form-vertical" action="<% baseUrl %>editmembership"  method="post" id="category_form" novalidate="novalidate">
                                        <input type="hidden" name="_token" value="PnhjGlM8lhVabo6sx6zR7OnlXpzV4MHJmqNVXF08"> 
                                        <input type="hidden" name="id" value="<%= membership._id %>">      
                                                                  <div class="form-body">
                                                                    <div class="form-body">
                                                                        <div class="row">
                                                                            <div class="col-12">
                                                                                <div class="form-group">
                                                                                    <% if(typeof message=="string" ) { %>
                                                                                        <p class="text-danger">
                                                                                            <%= message %>
                                                                                        </p>
                                                                                        <% } %>
                                                                                            <label for="assessment_title">Membership Period (in
                                                                                                years)</label>
                                                                                            <input type="number" onchange="eventHandler(this)"
                                                                                                id="membershiperiod" class="form-control"
                                                                                                name="membershiperiod"
                                                                                                placeholder="Membership Period (in years)" value="<%=  membership.membershiperiod %>">
                                                                                            <% if(typeof errors=="object" ) { %>
                                                                                                <p style="color: red;" class="membershiperiod">
                                                                                                    <%= errors.membershiperiod %>
                                                                                                </p>
                                                                                                <% } %>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-12">
                                                                                <div class="form-group">
                                                                                    <% if(typeof message=="string" ) { %>
                                                                                        <p class="text-danger">
                                                                                            <%= message %>
                                                                                        </p>
                                                                                        <% } %>
                                                                                            <!-- Paypal field removed -->
                                                                                            <label for="assessment_title">Price For USDT</label>
                                                                                            <input type="number" onchange="eventHandler(this)"
                                                                                                id="usdt" class="form-control" name="usdt"
                                                                                                placeholder="USDT" value="<%=  membership.usdt %>">
                                                                                            <% if(typeof errors=="object" ) { %>
                                                                                                <p style="color: red;" class="usdt">
                                                                                                    <%= errors.usdt %>
                                                                                                </p>
                                                                                            <% } %>
                                                                                            <label for="assessment_title">Price For Telegram Coin</label>
                                                                                            <input type="number" onchange="eventHandler(this)"
                                                                                                id="telegramcoin" class="form-control" name="telegramcoin"
                                                                                                placeholder="Telegram Coin" value="<%=  membership.telegramcoin %>">
                                                                                            <% if(typeof errors=="object" ) { %>
                                                                                                <p style="color: red;" class="telegramcoin">
                                                                                                    <%= errors.telegramcoin %>
                                                                                                </p>
                                                                                            <% } %>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-12">
                                                                                <div class="form-group">
                                                                                    <% if(typeof message=="string" ) { %>
                                                                                        <p class="text-danger">
                                                                                            <%= message %>
                                                                                        </p>
                                                                                        <% } %>
                                                                                            <!-- <label for="assessment_title">Price For Toncoin </label>
                                                                                            <input type="number" onchange="eventHandler(this)"
                                                                                                id="toncoin" class="form-control" name="toncoin"
                                                                                                placeholder=" Toncoin" value="<%=  membership.toncoin %>">
                                                                                            <% if(typeof errors=="object" ) { %>
                                                                                                <p style="color: red;" class="toncoin">
                                                                                                    <%= errors.toncoin %>
                                                                                                </p>
                                                                                                <% } %> -->
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-12 d-flex justify-content-end">
                                                                                <button type="submit" id="submit_btn"
                                                                                    class="btn btn-primary me-1 mb-1"><span>Save</span></button>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
        </div>

        </section>
        <footer>
            <div class="footer clearfix mb-0 text-muted">
                <div class="float-start">
                    <p>2023 &copy; All rights are reserved</p>
                </div>
               
            </div>
        </footer>
        </div>

        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="//cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
        <script>
            $(document).ready(function () {
                var table = $('#table1').DataTable();
            });
        </script>
        <script>
            function eventHandler(e) {
              const { id,  name, value } = e
              if (value.length > 0) {
                $(`.${name}`).text("")
              }
            }
          </script>


        <%- include('../Layout/Footer') %>