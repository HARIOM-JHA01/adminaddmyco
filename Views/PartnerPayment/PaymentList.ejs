<%- include('../Layout/Header') %>
<link
  rel="stylesheet"
  href="//cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css"
/>
<%- include('../Layout/Sidebar') %>
<div id="main">
  <div class="page-heading">
    <div class="page-title mb-3">
      <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
          <h3>
            <a href="<%= baseUrl %>admin/dashboard" class="text-primary"
              ><i class="fas fa-arrow-left me-2"></i></a
            >Partner Payments
          </h3>
        </div>
        <div
          class="col-12 col-md-6 order-md-2 order-first d-flex justify-content-end align-items-center"
        >
          <nav
            aria-label="breadcrumb"
            class="breadcrumb-header float-start float-lg-end me-4 mb-0"
          >
            <ol class="breadcrumb" style="margin-bottom: 0px">
              <li class="breadcrumb-item">
                <a href="<%= baseUrl %>admin/dashboard">Dashboard</a>
              </li>
            </ol>
          </nav>
        </div>
      </div>
    </div>
    <section class="section">
      <div class="card-body">
        <!-- Filter Tabs -->
        <ul class="nav nav-tabs" id="paymentTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button
              class="nav-link active"
              id="pending-tab"
              data-bs-toggle="tab"
              data-bs-target="#pending"
              type="button"
              role="tab"
            >
              Pending <span class="badge bg-warning"><%= pendingCount %></span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button
              class="nav-link"
              id="approved-tab"
              data-bs-toggle="tab"
              data-bs-target="#approved"
              type="button"
              role="tab"
            >
              Approved
              <span class="badge bg-success"><%= approvedCount %></span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button
              class="nav-link"
              id="rejected-tab"
              data-bs-toggle="tab"
              data-bs-target="#rejected"
              type="button"
              role="tab"
            >
              Rejected <span class="badge bg-danger"><%= rejectedCount %></span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button
              class="nav-link"
              id="all-tab"
              data-bs-toggle="tab"
              data-bs-target="#all"
              type="button"
              role="tab"
            >
              All <span class="badge bg-info"><%= payments.length %></span>
            </button>
          </li>
        </ul>

        <div class="tab-content mt-3" id="paymentTabsContent">
          <!-- Pending Tab -->
          <div class="tab-pane fade show active" id="pending" role="tabpanel">
            <div class="table-responsive">
              <table
                class="table table-striped mb-0 payment-table"
                id="pending_table"
              >
                <thead>
                  <tr>
                    <th>No.</th>
                    <th>Partner</th>
                    <th>Package</th>
                    <th>Amount</th>
                    <th>Transaction ID</th>
                    <th>Wallet Address</th>
                    <th>Payment Date</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% var i=1; payments.filter(p => p.status ===
                  0).forEach(function(v) { %>
                  <tr data-id="<%= v._id%>">
                    <td><%= i %></td>
                    <td>
                      <a
                        href="<%= baseUrl %>admin/partner/view/<%= v.partner._id %>"
                      >
                        <%= v.partner.username || v.partner.tgid %>
                      </a>
                    </td>
                    <td>
                      <%= v.package.name %> (<%= v.package.type ===
                      'USER_CREDITS' ? 'User' : 'Renewal' %>)
                    </td>
                    <td><strong>$<%= v.amount %></strong></td>
                    <td><%= v.transactionId %></td>
                    <td><%= v.walletAddress %></td>
                    <td>
                      <%= moment(v.createdAt).format('DD-MM-YYYY HH:mm') %>
                    </td>
                    <td>
                      <button
                        class="btn btn-success btn-sm approve-btn"
                        data-id="<%= v._id%>"
                        data-partner="<%= v.partner._id%>"
                        type="button"
                      >
                        <i class="bi bi-check-circle"></i> Approve
                      </button>
                      <button
                        class="btn btn-warning btn-sm reject-btn"
                        data-id="<%= v._id%>"
                        type="button"
                      >
                        <i class="bi bi-x-circle"></i> Reject
                      </button>
                    </td>
                  </tr>
                  <% i++ %> <% }) %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Approved Tab -->
          <div class="tab-pane fade" id="approved" role="tabpanel">
            <div class="table-responsive">
              <table
                class="table table-striped mb-0 payment-table"
                id="approved_table"
              >
                <thead>
                  <tr>
                    <th>No.</th>
                    <th>Partner</th>
                    <th>Package</th>
                    <th>Amount</th>
                    <th>Transaction ID</th>
                    <th>Payment Date</th>
                    <th>Approved Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% var i=1; payments.filter(p => p.status ===
                  1).forEach(function(v) { %>
                  <tr>
                    <td><%= i %></td>
                    <td>
                      <a
                        href="<%= baseUrl %>admin/partner/view/<%= v.partner._id %>"
                      >
                        <%= v.partner.username || v.partner.tgid %>
                      </a>
                    </td>
                    <td><%= v.package.name %></td>
                    <td>
                      <%= v.package.name %> (<%= v.package.type ===
                      'USER_CREDITS' ? 'User' : 'Renewal' %>)
                    </td>
                    <td>$<%= v.amount %></td>
                    <td><%= v.transactionId %></td>
                    <td>
                      <%= moment(v.createdAt).format('DD-MM-YYYY HH:mm') %>
                    </td>
                    <td>
                      <%= moment(v.approvedAt).format('DD-MM-YYYY HH:mm') %>
                    </td>
                  </tr>
                  <% i++ %> <% }) %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Rejected Tab -->
          <div class="tab-pane fade" id="rejected" role="tabpanel">
            <div class="table-responsive">
              <table
                class="table table-striped mb-0 payment-table"
                id="rejected_table"
              >
                <thead>
                  <tr>
                    <th>No.</th>
                    <th>Partner</th>
                    <th>Package</th>
                    <th>Amount</th>
                    <th>Transaction ID</th>
                    <th>Payment Date</th>
                    <th>Rejected Date</th>
                    <th>Reason</th>
                  </tr>
                </thead>
                <tbody>
                  <% var i=1; payments.filter(p => p.status ===
                  2).forEach(function(v) { %>
                  <tr>
                    <td><%= i %></td>
                    <td>
                      <a
                        href="<%= baseUrl %>admin/partner/view/<%= v.partner._id %>"
                      >
                        <%= v.partner.username || v.partner.tgid %>
                      </a>
                    </td>
                    <td><%= v.package.name %></td>
                    <td>
                      <%= v.package.name %> (<%= v.package.type ===
                      'USER_CREDITS' ? 'User' : 'Renewal' %>)
                    </td>
                    <td>$<%= v.amount %></td>
                    <td><%= v.transactionId %></td>
                    <td>
                      <%= moment(v.createdAt).format('DD-MM-YYYY HH:mm') %>
                    </td>
                    <td>
                      <%= moment(v.approvedAt).format('DD-MM-YYYY HH:mm') %>
                    </td>
                    <td><%= v.rejectionReason || 'N/A' %></td>
                  </tr>
                  <% i++ %> <% }) %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- All Tab -->
          <div class="tab-pane fade" id="all" role="tabpanel">
            <div class="table-responsive">
              <table
                class="table table-striped mb-0 payment-table"
                id="all_table"
              >
                <thead>
                  <tr>
                    <th>No.</th>
                    <th>Partner</th>
                    <th>Package</th>
                    <th>Amount</th>
                    <th>Transaction ID</th>
                    <th>Status</th>
                    <th>Payment Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% var i=1; payments.forEach(function(v) { %>
                  <tr>
                    <td><%= i %></td>
                    <td>
                      <a
                        href="<%= baseUrl %>admin/partner/view/<%= v.partner._id %>"
                      >
                        <%= v.partner.username || v.partner.tgid %>
                      </a>
                    </td>
                    <td><%= v.package.name %></td>
                    <td>$<%= v.amount %></td>
                    <td><%= v.transactionId %></td>
                    <td>
                      <% if (v.status === 0) { %>
                      <span class="badge bg-warning">Pending</span>
                      <% } else if (v.status === 1) { %>
                      <span class="badge bg-success">Approved</span>
                      <% } else { %>
                      <span class="badge bg-danger">Rejected</span>
                      <% } %>
                    </td>
                    <td>
                      <%= moment(v.createdAt).format('DD-MM-YYYY HH:mm') %>
                    </td>
                  </tr>
                  <% i++ %> <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  const baseUrl = "<%= baseUrl %>";

  $(document).ready(function () {
    console.log("PaymentList script loaded");
    console.log("jQuery version:", $.fn.jquery);
    console.log("baseUrl:", baseUrl);

    // Initialize DataTables for all tables with specific configurations
    $("#pending_table").DataTable({
      order: [[6, "desc"]], // Sort by Payment Date descending
      columnDefs: [
        { orderable: false, targets: 7 }, // Disable sorting on Action column
      ],
    });

    $("#approved_table, #rejected_table, #all_table").DataTable({
      order: [[0, "asc"]], // Sort by No. ascending
    });

    console.log("DataTables initialized");
    console.log("Approve buttons found:", $(".approve-btn").length);
    console.log("Reject buttons found:", $(".reject-btn").length);

    // Approve payment (delegated handler to work with DataTables DOM)
    $(document).on("click", ".approve-btn", function (e) {
      e.preventDefault();
      e.stopPropagation();
      console.log("Approve button clicked");

      const id = $(this).data("id");
      const $btn = $(this);
      const origHtml = $btn.html();

      console.log("Payment ID:", id);

      Swal.fire({
        title: "Approve Payment?",
        text: "This will add credits to the partner's account.",
        icon: "question",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, approve it!",
      }).then((result) => {
        if (result.isConfirmed) {
          // Use POST JSON instead of GET. Keep server GET support for backwards compatibility.
          $btn
            .prop("disabled", true)
            .html(
              '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Approving...'
            );

          $.ajax({
            url: `${baseUrl}admin/payment/approve`,
            method: "POST",
            data: { paymentId: id },
            success: function (response) {
              console.log("Approve success:", response);
              Swal.fire(
                "Approved!",
                "Payment has been approved and credits added.",
                "success"
              ).then(() => {
                // Remove the row from the table instead of reloading
                $("#pending_table")
                  .DataTable()
                  .row($btn.closest("tr"))
                  .remove()
                  .draw();
                // Update pending count badge
                const currentPending =
                  parseInt($("#pending-tab .badge").text()) - 1;
                $("#pending-tab .badge").text(currentPending);
                // Update all count badge
                const currentAll = parseInt($("#all-tab .badge").text()) - 1;
                $("#all-tab .badge").text(currentAll);
              });
            },
            error: function (xhr, status, error) {
              console.error("Approve error:", xhr, status, error);
              // restore button state
              $btn.prop("disabled", false).html(origHtml);
              Swal.fire(
                "Error!",
                xhr.responseJSON?.message || "Failed to approve payment.",
                "error"
              );
            },
          });
        }
      });
    });

    // Reject payment (delegated handler)
    $(document).on("click", ".reject-btn", function (e) {
      e.preventDefault();
      e.stopPropagation();
      console.log("Reject button clicked");

      const id = $(this).data("id");
      const $btn = $(this);
      const origHtml = $btn.html();

      console.log("Payment ID:", id);

      Swal.fire({
        title: "Reject Payment?",
        input: "textarea",
        inputLabel: "Rejection Reason",
        inputPlaceholder: "Enter reason for rejection...",
        inputAttributes: {
          "aria-label": "Enter reason for rejection",
        },
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Yes, reject it!",
        preConfirm: (reason) => {
          if (!reason) {
            Swal.showValidationMessage("Please enter a reason for rejection");
          }
          return reason;
        },
      }).then((result) => {
        if (result.isConfirmed) {
          $btn
            .prop("disabled", true)
            .html(
              '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Rejecting...'
            );

          $.ajax({
            url: `${baseUrl}admin/payment/reject`,
            method: "POST",
            data: { paymentId: id, reason: result.value },
            success: function (response) {
              console.log("Reject success:", response);
              Swal.fire(
                "Rejected!",
                "Payment has been rejected.",
                "success"
              ).then(() => {
                // Remove the row from the table instead of reloading
                $("#pending_table")
                  .DataTable()
                  .row($btn.closest("tr"))
                  .remove()
                  .draw();
                // Update pending count badge
                const currentPending =
                  parseInt($("#pending-tab .badge").text()) - 1;
                $("#pending-tab .badge").text(currentPending);
                // Update all count badge
                const currentAll = parseInt($("#all-tab .badge").text()) - 1;
                $("#all-tab .badge").text(currentAll);
              });
            },
            error: function (xhr, status, error) {
              console.error("Reject error:", xhr, status, error);
              // restore button state
              $btn.prop("disabled", false).html(origHtml);
              Swal.fire(
                "Error!",
                xhr.responseJSON?.message || "Failed to reject payment.",
                "error"
              );
            },
          });
        }
      });
    });
  });
</script>
<%- include('../Layout/Footer') %>
